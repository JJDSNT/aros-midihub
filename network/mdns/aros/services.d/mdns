#
# AROSTCP network service: mDNS/DNS-SD responder and browser (mdnsd).
#
# bonami.library is its client: applications register and browse services
# through the library, and this one daemon speaks for the host on UDP 5353.
#
#   Path    - the daemon executable
#   Order   - bring-up priority hint (higher starts earlier)
#   StopSig - signal bit sent to stop it (12 = CTRL-C)
#   Policy  - signal: across a reconfiguration it lets go of the stack and
#             takes it up again, keeping what applications registered
#   Enabled - yes or no
#
Name=mDNS Responder
Path=SYS:System/Network/Services/mdnsd
Order=20
StopSig=12
Policy=signal
Enabled=yes
