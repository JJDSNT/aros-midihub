#
# AROSTCP network service: AppleMIDI (RTP-MIDI) sessions (applemidid).
#
# It answers invitations on UDP 5004 and 5005, invites the peers it is
# configured to, and advertises the session as _apple-midi._udp through
# the mDNS service. It takes no arguments: what it does is in its
# configuration.
#
#   Path    - the daemon executable
#   Order   - bring-up priority hint (higher starts earlier): after mDNS
#   StopSig - signal bit sent to stop it (12 = CTRL-C)
#   Policy  - restart: across a reconfiguration of the stack it is stopped
#             and started again, and its sessions with it
#   Enabled - yes or no. No for now: the programs of this package still
#             start the same runtime by hand, on the same ports.
#
Name=AppleMIDI
Path=SYS:System/Network/Services/applemidid
Order=10
StopSig=12
Policy=restart
Enabled=no
