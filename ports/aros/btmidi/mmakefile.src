include $(SRCDIR)/config/aros.cfg

MIDIHUB_ROOT := $(SRCDIR)/$(patsubst %/ports/aros/btmidi,%,$(CURDIR))

USER_INCLUDES := -I$(MIDIHUB_ROOT)/include -I$(MIDIHUB_ROOT)/ports/aros
USER_CFLAGS := -Wall -Wextra -Werror -Wno-volatile-register-var
USER_LDFLAGS := -static

#MM- contrib-aros-midihub-btmidi : \
#MM      linklibs-arosmidihub \
#MM      kernel-bluetooth-btclass \
#MM      kernel-bluetooth-library-includes

%build_module_library mmake=contrib-aros-midihub-btmidi \
    modname=btmidi modtype=btclass modsuffix="class" \
    files="btmidi $(MIDIHUB_ROOT)/ports/aros/midihub/camd_bridge" \
    uselibs=arosmidihub

%common
