# Native AROS MetaMake integration. Place this checkout at
# contrib/aros-midihub in the AROS source tree.

include $(SRCDIR)/config/aros.cfg

#MM- contrib : contrib-aros-midihub
#MM- contrib-aros-midihub : \
#MM      linklibs-arosmidihub \
#MM      contrib-aros-midihub-package \
#MM      contrib-aros-midihub-selftest \
#MM      contrib-aros-midihub-camdprobe \
#MM      contrib-aros-midihub-camdcompat \
#MM      contrib-aros-midihub-camdidentities \
#MM      contrib-aros-midihub-netreload \
#MM      contrib-aros-midihub-mcastjoin \
#MM      contrib-aros-midihub-synth \
#MM      contrib-aros-midihub-router \
#MM      contrib-aros-midihub-prefs \
#MM      contrib-aros-midihub-drawer-icons \
#MM      contrib-aros-midihub-btmidi \
#MM      contrib-aros-midihub-bonami \
#MM      contrib-aros-midihub-mdnsd \
#MM      contrib-aros-midihub-mdnstools \
#MM      contrib-aros-midihub-mdnscx \
#MM      contrib-aros-midihub-mdnsprobe \
#MM      contrib-aros-midihub-netmidid
#MM contrib-aros-midihub-selftest : linklibs-arosmidihub
#MM contrib-aros-midihub-ble : linklibs-arosmidihub kernel-bluetooth-library-includes
#MM- contrib-aros-midihub-prefs : contrib-aros-midihub-prefs-icon
#MM contrib-aros-midihub-prefs : linklibs-arosmidihub \
#MM      kernel-bluetooth-library-includes kernel-bluetooth-btclass

MIDIHUB_ROOT := $(SRCDIR)/$(CURDIR)
MIDIHUB_PACKAGE := $(AROS_CONTRIB)/aros-midihub

USER_INCLUDES := -I$(MIDIHUB_ROOT)/include \
    -I$(MIDIHUB_ROOT)/third_party/TinySoundFont \
    -I$(MIDIHUB_ROOT)/network/mdns/aros/include \
    -I$(MIDIHUB_ROOT)/network/mdns/aros/src
# Older m68k AROS inline stubs intentionally use volatile register variables.
USER_CFLAGS := -Wall -Wextra -Werror -Wno-volatile-register-var
# What the package builds has all of it: Network MIDI 2.0 and discovery.
# Everything that shares struct netmidi_network_config has to be built
# with the same two, since they decide which fields it has.
USER_CPPFLAGS := -DNETMIDI_MIDI2 -DNETMIDI_DISCOVERY -DNETMIDI_BROWSE

%build_linklib mmake=linklibs-arosmidihub \
    libname=arosmidihub \
    files="$(MIDIHUB_ROOT)/network/rtpmidi/applemidi $(MIDIHUB_ROOT)/network/rtpmidi/rtpmidi \
           $(MIDIHUB_ROOT)/network/rtpmidi/session $(MIDIHUB_ROOT)/network/rtpmidi/peers \
           $(MIDIHUB_ROOT)/network/rtpmidi/ports \
           $(MIDIHUB_ROOT)/src/config \
           $(MIDIHUB_ROOT)/network/rtpmidi/timing $(MIDIHUB_ROOT)/network/rtpmidi/sender \
           $(MIDIHUB_ROOT)/network/rtpmidi/receiver \
           $(MIDIHUB_ROOT)/network/rtpmidi/clock \
           $(MIDIHUB_ROOT)/src/routes \
           $(MIDIHUB_ROOT)/src/ble_midi \
           $(MIDIHUB_ROOT)/src/ble_peripheral \
           $(MIDIHUB_ROOT)/src/ump $(MIDIHUB_ROOT)/src/netmidi2"

BONAMI_AROS := $(MIDIHUB_ROOT)/network/mdns/aros
BONAMI_SRC := $(BONAMI_AROS)/src
BONAMI_FILES := \
    $(BONAMI_SRC)/bonami_init \
    $(BONAMI_SRC)/bonami_api \
    $(BONAMI_SRC)/bonami_ipc
MDNSD_FILES := \
    $(BONAMI_SRC)/mdnsd \
    $(BONAMI_SRC)/mdnsd_service \
    $(BONAMI_SRC)/mdns_dns \
    $(BONAMI_SRC)/mdns_net \
    $(BONAMI_SRC)/mdns_engine \
    $(BONAMI_SRC)/mdns_reg \
    $(BONAMI_SRC)/mdns_browse \
    $(BONAMI_SRC)/mdns_query \
    $(BONAMI_SRC)/mdns_inquiry

# Incubating system mDNS/DNS-SD library. It installs in LIBS: for package
# testing and is intended to move to workbench/network when upstreamed.
#MM contrib-aros-midihub-bonami : \
#MM      contrib-aros-midihub-bonami-includes
%build_module mmake=contrib-aros-midihub-bonami \
    modname=bonami modtype=library \
    conffile=$(BONAMI_AROS)/bonami.conf \
    files="$(BONAMI_FILES)" \
    cflags="-Wall -Wextra -Werror -Wno-volatile-register-var \
            -Wno-unused-parameter -Wno-missing-field-initializers \
            -Wno-pointer-sign"

# build_module's generic clean rule removes the generated ABI headers but not
# the stamp that says they exist.  Remove that stamp too, otherwise the first
# build after -clean tries to copy headers that were never regenerated.
contrib-aros-midihub-bonami-clean ::
	$(Q)$(RM) $(contrib-aros-midihub-bonami-includes_GENINCFLAG)

#MM- contrib-aros-midihub-bonami-includes : \
#MM      contrib-aros-midihub-bonami-include-api \
#MM      contrib-aros-midihub-bonami-include-base
%copy_includes mmake=contrib-aros-midihub-bonami-include-api \
    path=bonami dir=$(BONAMI_AROS)/include/bonami \
    includes="mdns.h nipc.h"
%copy_includes mmake=contrib-aros-midihub-bonami-include-base \
    path=libraries dir=$(BONAMI_AROS)/include/libraries \
    includes="bonamibase.h"

# The daemon behind the library, managed by the AROSTCP service manager.
#MM contrib-aros-midihub-mdnsd : \
#MM      contrib-aros-midihub-bonami-includes \
#MM      contrib-aros-midihub-mdnsd-svccfg
%build_prog mmake=contrib-aros-midihub-mdnsd \
    progname=mdnsd \
    files="$(MDNSD_FILES)" \
    targetdir=$(AROS_SYSTEM)/Network/Services \
    cflags="-Wall -Wextra -Werror -Wno-volatile-register-var \
            -Wno-unused-parameter -Wno-missing-field-initializers \
            -Wno-pointer-sign"

%copy_files_q mmake=contrib-aros-midihub-mdnsd-svccfg \
    files="mdns" src=$(BONAMI_AROS)/services.d \
    dst=$(AROS_SYSTEM)/Network/AROSTCP/db/services.d

# Bonami's command-line tools, ported from its SDK examples.
BONAMI_TOOLS := $(BONAMI_AROS)/tools
BONAMI_TOOL_CFLAGS := -Wall -Wextra -Wno-unused-parameter -Wno-pointer-sign \
    -Wno-volatile-register-var

#MM- contrib-aros-midihub-mdnstools : \
#MM      contrib-aros-midihub-mdnstools-nearby \
#MM      contrib-aros-midihub-mdnstools-handshake \
#MM      contrib-aros-midihub-mdnstools-share \
#MM      contrib-aros-midihub-mdnstools-dnssd
#MM contrib-aros-midihub-mdnstools-nearby : contrib-aros-midihub-bonami
#MM contrib-aros-midihub-mdnstools-handshake : contrib-aros-midihub-bonami
#MM contrib-aros-midihub-mdnstools-share : contrib-aros-midihub-bonami
#MM contrib-aros-midihub-mdnstools-dnssd : contrib-aros-midihub-bonami

%build_prog mmake=contrib-aros-midihub-mdnstools-nearby progname=Nearby \
    files="$(BONAMI_TOOLS)/nearby $(BONAMI_TOOLS)/ba_common $(BONAMI_TOOLS)/ba_types" \
    targetdir=$(MIDIHUB_PACKAGE)/C cflags="$(BONAMI_TOOL_CFLAGS)"
%build_prog mmake=contrib-aros-midihub-mdnstools-handshake progname=Handshake \
    files="$(BONAMI_TOOLS)/handshake $(BONAMI_TOOLS)/ba_common $(BONAMI_TOOLS)/ba_types" \
    targetdir=$(MIDIHUB_PACKAGE)/C cflags="$(BONAMI_TOOL_CFLAGS)"
%build_prog mmake=contrib-aros-midihub-mdnstools-share progname=Share \
    files="$(BONAMI_TOOLS)/share $(BONAMI_TOOLS)/ba_common $(BONAMI_TOOLS)/ba_types" \
    targetdir=$(MIDIHUB_PACKAGE)/C cflags="$(BONAMI_TOOL_CFLAGS)"
%build_prog mmake=contrib-aros-midihub-mdnstools-dnssd progname=dnssd \
    files="$(BONAMI_TOOLS)/dnssd $(BONAMI_TOOLS)/ba_common" \
    targetdir=$(MIDIHUB_PACKAGE)/C cflags="$(BONAMI_TOOL_CFLAGS)"

# Bonami's GadTools commodity: Nearby, Handshake and Share in one window.
BONAMI_CX := $(BONAMI_AROS)/commodity
#MM contrib-aros-midihub-mdnscx : contrib-aros-midihub-bonami
%build_prog mmake=contrib-aros-midihub-mdnscx progname=Bonami \
    files="$(BONAMI_CX)/bonami_main $(BONAMI_CX)/bonami_window \
           $(BONAMI_CX)/bonami_mdns $(BONAMI_CX)/bonami_types" \
    targetdir=$(MIDIHUB_PACKAGE)/C cflags="$(BONAMI_TOOL_CFLAGS)"

#MM contrib-aros-midihub-mdnsprobe : \
#MM      contrib-aros-midihub-bonami
%build_prog mmake=contrib-aros-midihub-mdnsprobe \
    progname=BonamiProbe \
    files="$(MIDIHUB_ROOT)/ports/aros/mdns_probe" \
    targetdir=$(MIDIHUB_PACKAGE)/C

#MM- contrib-aros-midihub-package : \
#MM      contrib-aros-midihub-package-startup \
#MM      contrib-aros-midihub-package-registration \
#MM      contrib-aros-midihub-package-license

%copy_files_q mmake=contrib-aros-midihub-package-startup \
    src="$(MIDIHUB_ROOT)/ports/aros/package/S" \
    files="Package-Startup" dst="$(MIDIHUB_PACKAGE)/S"

%copy_files_q mmake=contrib-aros-midihub-package-registration \
    src="$(MIDIHUB_ROOT)/ports/aros/package/Packages" \
    files="aros-midihub" dst="$(AROS_ENVARC)/SYS/Packages"

%copy_files_q mmake=contrib-aros-midihub-package-license \
    src="$(MIDIHUB_ROOT)" files="LICENSE" dst="$(MIDIHUB_PACKAGE)"

# Network MIDI as a service of the AROSTCP service manager: started with
# the stack, without a console or arguments. It runs the AppleMIDI and the
# Network MIDI 2.0 sessions and reaches CAMD through the two drivers below,
# not as a client of camd.library.
#MM contrib-aros-midihub-netmidid : linklibs-arosmidihub \
#MM      contrib-aros-midihub-bonami \
#MM      contrib-aros-midihub-netmidid-svccfg \
#MM      contrib-aros-midihub-applemidi-driver \
#MM      contrib-aros-midihub-networkmidi2-driver \
#MM      contrib-aros-midihub-applemidi-driver-layout2 \
#MM      contrib-aros-midihub-netmidistat
%build_prog mmake=contrib-aros-midihub-netmidid \
    progname=netmidid \
    files="$(MIDIHUB_ROOT)/ports/aros/midihub/main \
           $(MIDIHUB_ROOT)/ports/aros/midihub/transport_applemidi \
           $(MIDIHUB_ROOT)/ports/aros/midihub/transport_midi2 \
           $(MIDIHUB_ROOT)/ports/aros/midihub/adapters \
           $(MIDIHUB_ROOT)/ports/aros/midihub/network \
           $(MIDIHUB_ROOT)/ports/aros/midihub/discovery" \
    objdir=$(GENDIR)/$(CURDIR)/netmidid \
    cppflags="-DNETMIDI_SERVICE -DNETMIDI_APPLEMIDI -DNETMIDI_MIDI2 -DNETMIDI_DISCOVERY -DNETMIDI_BROWSE -I$(MIDIHUB_ROOT)/ports/aros/netmidi" \
    uselibs=arosmidihub \
    targetdir=$(AROS_SYSTEM)/Network/Services

# The CAMD drivers the service attaches to, one to a transport, from one
# source: ports and no network code.
%build_prog mmake=contrib-aros-midihub-applemidi-driver \
    progname=applemidi \
    files="$(MIDIHUB_ROOT)/ports/aros/netmidi/netmididriver" \
    objdir=$(GENDIR)/$(CURDIR)/applemidi-driver \
    targetdir=$(AROS_DEVS)/Midi

%build_prog mmake=contrib-aros-midihub-networkmidi2-driver \
    progname=networkmidi2 \
    files="$(MIDIHUB_ROOT)/ports/aros/netmidi/netmididriver" \
    objdir=$(GENDIR)/$(CURDIR)/networkmidi2-driver \
    cppflags="-DNETMIDI_DRIVER_NETWORKMIDI2" \
    targetdir=$(AROS_DEVS)/Midi

# What the service says about its ports, for a shell.
%build_prog mmake=contrib-aros-midihub-netmidistat \
    progname=NetMIDIStatus \
    files="$(MIDIHUB_ROOT)/ports/aros/netmidi/netmidistat" \
    targetdir=$(AROS_C)

# For tools/netmidi-driver-hosted.sh alone: the driver as a later layout
# would make it, to put in the place of DEVS:Midi/applemidi.
%build_prog mmake=contrib-aros-midihub-applemidi-driver-layout2 \
    progname=applemidi-layout2 \
    files="$(MIDIHUB_ROOT)/ports/aros/netmidi/netmididriver" \
    objdir=$(GENDIR)/$(CURDIR)/applemidi-driver-layout2 \
    cppflags="-DNETMIDI_ADAPTERS_VERSION=2" \
    targetdir=$(MIDIHUB_PACKAGE)/C

%copy_files_q mmake=contrib-aros-midihub-netmidid-svccfg \
    files="netmidi" src=$(MIDIHUB_ROOT)/ports/aros/midihub/services.d \
    dst=$(AROS_SYSTEM)/Network/AROSTCP/db/services.d

%build_prog mmake=contrib-aros-midihub-selftest \
    progname=aros-midihub-selftest \
    files="$(MIDIHUB_ROOT)/ports/aros/selftest/selftest" \
    uselibs=arosmidihub \
    targetdir=$(MIDIHUB_PACKAGE)/C

%build_prog mmake=contrib-aros-midihub-camdprobe \
    progname=MIDIHubCAMDProbe \
    files="$(MIDIHUB_ROOT)/ports/aros/camd_probe" \
    targetdir=$(MIDIHUB_PACKAGE)/C

%build_prog mmake=contrib-aros-midihub-camdcompat \
    progname=MIDIHubCAMDCompat \
    files="$(MIDIHUB_ROOT)/ports/aros/camd_compat" \
    targetdir=$(MIDIHUB_PACKAGE)/C

%build_prog mmake=contrib-aros-midihub-mcastjoin \
    progname=McastJoin \
    files="$(MIDIHUB_ROOT)/ports/aros/mcast_join" \
    targetdir=$(MIDIHUB_PACKAGE)/C

%build_prog mmake=contrib-aros-midihub-netreload \
    progname=NetReload \
    files="$(MIDIHUB_ROOT)/ports/aros/net_reload" \
    targetdir=$(MIDIHUB_PACKAGE)/C

%build_prog mmake=contrib-aros-midihub-camdidentities \
    progname=CAMDIdentities \
    files="$(MIDIHUB_ROOT)/ports/aros/camd_identities" \
    targetdir=$(MIDIHUB_PACKAGE)/C

%build_prog mmake=contrib-aros-midihub-router \
    progname=MIDIHubRouter \
    files="$(MIDIHUB_ROOT)/ports/aros/router" \
    uselibs=arosmidihub \
    targetdir=$(MIDIHUB_PACKAGE)/C

# Inside the package for now: whether a MIDI Preferences belongs in
# SYS:Prefs is for upstream to decide.
%build_prog mmake=contrib-aros-midihub-prefs \
    progname=MIDIHub \
    files="$(MIDIHUB_ROOT)/ports/aros/prefs \
           $(MIDIHUB_ROOT)/ports/aros/MIDIHubPrefsClass" \
    uselibs="arosmidihub mui" \
    targetdir=$(MIDIHUB_PACKAGE)/Prefs

%copy_files_q mmake=contrib-aros-midihub-prefs-icon \
    src="$(MIDIHUB_ROOT)/ports/aros" files="MIDIHub.info" \
    dst="$(MIDIHUB_PACKAGE)/Prefs"

# Drawer icons (AROS's default drawer), so Workbench shows the package
# drawer and its Prefs drawer.
#MM- contrib-aros-midihub-drawer-icons : \
#MM      contrib-aros-midihub-drawer-icon contrib-aros-midihub-prefs-drawer-icon
%copy_files_q mmake=contrib-aros-midihub-drawer-icon \
    src="$(MIDIHUB_ROOT)/ports/aros/package/icons" files="aros-midihub.info" \
    dst="$(AROS_CONTRIB)"
%copy_files_q mmake=contrib-aros-midihub-prefs-drawer-icon \
    src="$(MIDIHUB_ROOT)/ports/aros/package/icons" files="Prefs.info" \
    dst="$(MIDIHUB_PACKAGE)"

# Optional: requires the AROS bluetooth.library and the GATT prerequisite patch.
%build_prog mmake=contrib-aros-midihub-ble \
    progname=MIDIHubBLE \
    files="$(MIDIHUB_ROOT)/ports/aros/ble_bridge \
           $(MIDIHUB_ROOT)/ports/aros/camd_bridge" \
    uselibs=arosmidihub \
    targetdir=$(MIDIHUB_PACKAGE)/C

# The live synthesizer plays a user-selected SoundFont; the bank is not
# part of the package.
#MM contrib-aros-midihub-synth : linklibs-arosmidihub

%build_prog mmake=contrib-aros-midihub-synth \
    progname=MIDIHubSynth \
    files="$(MIDIHUB_ROOT)/ports/aros/synth_service $(MIDIHUB_ROOT)/src/synth" \
    targetdir=$(MIDIHUB_PACKAGE)/C

# The bank is large and has a separate license, so this target is opt-in.
#MM- contrib-aros-midihub-soundfonttest : \
#MM      contrib-aros-midihub-soundfonttest-program \
#MM      contrib-aros-midihub-soundfontplay-program \
#MM      contrib-aros-midihub-soundfonttest-bank

%build_prog mmake=contrib-aros-midihub-soundfonttest-program \
    progname=SoundFontTest \
    files="$(MIDIHUB_ROOT)/tests/synth_render $(MIDIHUB_ROOT)/src/synth" \
    targetdir=$(MIDIHUB_PACKAGE)/C

%build_prog mmake=contrib-aros-midihub-soundfontplay-program \
    progname=SoundFontPlay \
    files="$(MIDIHUB_ROOT)/ports/aros/soundfont_play $(MIDIHUB_ROOT)/src/synth" \
    targetdir=$(MIDIHUB_PACKAGE)/C

%copy_files_q mmake=contrib-aros-midihub-soundfonttest-bank \
    src="$(MIDIHUB_ROOT)/soundfonts/GeneralUser-GS" \
    files="GeneralUser-GS.sf2" dst="$(MIDIHUB_PACKAGE)/SoundFonts"

%common
