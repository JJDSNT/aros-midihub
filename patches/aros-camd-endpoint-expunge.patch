+/* Called from expunge with the library closed, so no client is inside CAMD
+ * and the snapshot table needs no lock. */
+BOOL EndpointClientsRemain(struct CamdBase *CamdBase)
+{
+    struct CamdBase_intern *base = CB(CamdBase);
+    ULONG i;
+
+    for (i = 0; i < ENDPOINT_SNAPSHOTS; ++i) {
+        if (base->EndpointSnapshots[i] != NULL)
+            return TRUE;
+    }
+    return camd_registry_session_count(base->EndpointRegistry) != 0;
+}
+
 /* Snapshots a client did not release. CAMD must be expunging. */
 void FreeEndpointSnapshots(struct CamdBase *CamdBase)
 {
diff --git a/workbench/libs/camd/endpoint_registry.c b/workbench/libs/camd/endpoint_registry.c
--- a/workbench/libs/camd/endpoint_registry.c
+++ b/workbench/libs/camd/endpoint_registry.c
@@ -890,6 +890,21 @@ out:
     return result;
 }
 
+size_t camd_registry_session_count(struct CAMDEndpointRegistry *registry)
+{
+    size_t count = 0, i;
+
+    if (!registry)
+        return 0;
+    core_lock_acquire(&registry->lock);
+    for (i = 0; i < registry->session_count; ++i) {
+        if (registry->sessions[i].occupied)
+            ++count;
+    }
+    core_lock_release(&registry->lock);
+    return count;
+}
