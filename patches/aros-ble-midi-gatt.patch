+/* GATT UUID values arrive least-significant byte first; public Bluetooth
+   service and endpoint UUIDs use the canonical big-endian byte order. */
+static void bGATTUUIDTo128(UWORD uuid16, UBYTE uuid_len, const uint8_t *uuid, UBYTE *out)
+{
+    UWORD i;
+    if(uuid_len == 16) {
+        for(i = 0; i < 16; i++) {
+            out[i] = uuid[15 - i];
+        }
+    } else {
+        bUUID16To128(uuid16, out);
+    }
+}
