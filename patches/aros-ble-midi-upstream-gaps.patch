+        return;
+    }
+    io_cap[0] = m->pres[3];
+    io_cap[1] = m->pres[4];
+    io_cap[2] = m->pres[5];
+    if (bt_smp_crypto_f6(&m->cmac, m->mac_key, m->local_random, m->peer_random,
+                         sc_f6_r(m, zero), io_cap, a2, a1, value) != BT_OK)
+        goto crypto;
