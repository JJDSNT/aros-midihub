+                         m->config.responder_address_type,
+                         m->config.initiator_address,
+                         m->config.responder_address, confirm) != BT_OK)
+        goto crypto;
+    reverse_copy(wire_confirm, confirm, 16);
+    bt_buf_writer_init(&w, pdu, sizeof(pdu));
