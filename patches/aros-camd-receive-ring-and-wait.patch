+	/* A full ring loses what comes in, not what is waiting to be read.
+	   The receiver process reports it. */
+	if(driverdata->unpicked>=RECEIVERPROCBUFFERSIZE-1){
+		driverdata->re_overflow=TRUE;
+		Signal(&driverdata->ReceiverProc->pr_Task,1L<<driverdata->ReceiverSig);
+		return;
+	}
 	*driverdata->re_write=input;
