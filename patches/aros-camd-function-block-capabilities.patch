+        for (j = 0; j < i; ++j) {
+            const struct CAMDFunctionBlockInfoV1 *previous =
+                (const struct CAMDFunctionBlockInfoV1 *)(block_bytes +
+                                                          j * block_stride);
+            if (previous->Number == block->Number)
                 return CAMD_REGISTRY_DUPLICATE;
+        }
     }
 
     if (group_count) {
