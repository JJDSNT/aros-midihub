diff --git a/workbench/libs/camd/putendpointump.c b/workbench/libs/camd/putendpointump.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/putendpointump.c
@@ -0,0 +1,66 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+#include "provider_contract.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH3(LONG, PutEndpointUMP,
+
+/*  SYNOPSIS */
+	AROS_LHA(struct CAMDHandleV1 *, session, A0),
+	AROS_LHA(struct CAMDUMPEventV1 *, events, A1),
+	AROS_LHA(ULONG, count, D0),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 66, Camd)
+
+/*  FUNCTION
+		Queues complete Universal MIDI Packet messages on a UMP
+		output session. Either all of them are queued, in order, or
+		none.
+
+    INPUTS
+		session - from OpenEndpointSession() with CAMD_DATA_FORMAT_UMP.
+		events - count records, each with Size, Version and WordCount
+		    set.
+		count - at least 1.
+
+    RESULT
+		CAMD_REGISTRY_OK, CAMD_REGISTRY_QUEUE_FULL, CAMD_REGISTRY_INVALID
+		for a WordCount that does not fit the message type,
+		CAMD_REGISTRY_UNSUPPORTED on a MIDI 1.0 session, or another
+		CAMD_REGISTRY_ value.
+
+    NOTES
+		New in V43 and provisional: the endpoint functions can still
+		change. Does not wait. CAMD carries the
+		words as they are and converts nothing.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		GetEndpointUMP(), PutEndpointMidi()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	if(session==NULL) return CAMD_REGISTRY_INVALID;
+
+	return camd_registry_session_send_ump(CB(CamdBase)->EndpointRegistry,
+		*session,events,count);
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/camd/putpublishedump.c b/workbench/libs/camd/putpublishedump.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/putpublishedump.c
@@ -0,0 +1,62 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+#include "provider_contract.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH3(LONG, PutPublishedUMP,
+
+/*  SYNOPSIS */
+	AROS_LHA(struct CAMDHandleV1 *, endpoint, A0),
+	AROS_LHA(struct CAMDUMPEventV1 *, events, A1),
+	AROS_LHA(ULONG, count, D0),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 68, Camd)
+
+/*  FUNCTION
+		Gives complete Universal MIDI Packet messages to every client
+		that receives from a published UMP endpoint.
+
+    INPUTS
+		endpoint - from PublishEndpoint() with CAMD_DATA_FORMAT_UMP.
+		events - count records, each with Size, Version and WordCount
+		    set.
+		count - at least 1.
+
+    RESULT
+		CAMD_REGISTRY_OK, CAMD_REGISTRY_STALE for a withdrawn endpoint,
+		CAMD_REGISTRY_INVALID also for a MIDI 1.0 endpoint, or another
+		CAMD_REGISTRY_ value.
+
+    NOTES
+		New in V43 and provisional: the endpoint functions can still
+		change. Does not wait.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		GetPublishedUMP(), PutPublishedMidi()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	if(endpoint==NULL) return CAMD_REGISTRY_INVALID;
+
+	return PutAppEndpointUMP(endpoint,events,count,CamdBase);
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/camd/setpublishedendpointtopology.c b/workbench/libs/camd/setpublishedendpointtopology.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/setpublishedendpointtopology.c
@@ -0,0 +1,72 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+#include "provider_contract.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH5(LONG, SetPublishedEndpointTopology,
+
+/*  SYNOPSIS */
+	AROS_LHA(struct CAMDHandleV1 *, endpoint, A0),
+	AROS_LHA(struct CAMDGroupInfoV1 *, groups, A1),
+	AROS_LHA(ULONG, groupcount, D0),
+	AROS_LHA(struct CAMDFunctionBlockInfoV1 *, blocks, A2),
+	AROS_LHA(ULONG, blockcount, D1),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 70, Camd)
+
+/*  FUNCTION
+		Replaces a published endpoint's Groups and Function Blocks as
+		a whole. Clients see the old set or the new one in a snapshot,
+		never a mixture, and their watches get an update.
+
+    INPUTS
+		endpoint - from PublishEndpoint().
+		groups - groupcount records with Size, Version, Group and Name
+		    set; EndpointID is filled in. NULL with a count of 0.
+		groupcount - the number of Groups.
+		blocks - blockcount records with Size, Version, Number,
+		    FirstGroup, GroupCount and Name set; EndpointID is filled
+		    in. NULL with a count of 0.
+		blockcount - the number of Function Blocks.
+
+    RESULT
+		CAMD_REGISTRY_OK, CAMD_REGISTRY_INVALID for a Group past 15 or
+		a block that spans past it, CAMD_REGISTRY_DUPLICATE for a
+		Group or block number given twice, or another CAMD_REGISTRY_
+		value. A refused set leaves the earlier one.
+
+    NOTES
+		New in V43 and provisional: the endpoint functions can still
+		change. CAMD checks the ranges only; it
+		does not route by Group.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		GetEndpointGroup(), GetEndpointFunctionBlock()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	if(endpoint==NULL) return CAMD_REGISTRY_INVALID;
+
+	return SetAppEndpointTopology(endpoint,groups,groupcount,blocks,
+		blockcount,CamdBase);
+
+    AROS_LIBFUNC_EXIT
+}
