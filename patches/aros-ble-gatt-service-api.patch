+static void bFinishLEAdvertising(struct BtHWCore *hc, LONG error)
+{
+    struct BtHardware *bth = hc->hc_Hardware;
+    struct BtGATTLocalService *service = hc->hc_AdvService;
+    struct BtChannel *request = hc->hc_AdvReq;
+    BOOL enable = hc->hc_AdvEnable;
+
+    hc->hc_AdvBusy = FALSE;
+    hc->hc_AdvReq = NULL;
+    hc->hc_AdvService = NULL;
+    if(!error) {
+        if(enable) {
+            bth->bth_LocalGATTService = service;
+            service->bgs_Hardware = bth;
+            btAddErrorMsg(RETURN_OK, (STRPTR) GM_UNIQUENAME(libname),
+                          "%s/%ld: LE peripheral advertising enabled.",
+                          bth->bth_DevName, bth->bth_Unit);
+        } else {
+            bth->bth_LocalGATTService = NULL;
+            service->bgs_Hardware = NULL;
+            bBgScanSchedule(hc);
+            btAddErrorMsg(RETURN_OK, (STRPTR) GM_UNIQUENAME(libname),
+                          "%s/%ld: LE peripheral advertising disabled.",
+                          bth->bth_DevName, bth->bth_Unit);
+        }
+    } else if(enable && !hc->hc_AdvWasActive) {
+        if(service->bgs_Hardware == bth) service->bgs_Hardware = NULL;
+        if(bth->bth_LocalGATTService == service) bth->bth_LocalGATTService = NULL;
+    }
+    if(request) bReplyChannel(hc->hc_Base, request, error, 0);
+}
+
+static void bLEAdvertisingCB(struct bt_cmdq_completion *completion, void *user_data)
+{
+    struct BtHWCore *hc = user_data;
+    if((completion->result != BT_CMDQ_RESULT_COMPLETE) || completion->status) {
+        hc->hc_Hardware->bth_LastHCIError = completion->status;
+        bFinishLEAdvertising(hc, BTIOERR_HOSTERROR);
+        return;
+    }
+    if(!hc->hc_AdvEnable || (++hc->hc_AdvStep == 5)) {
+        bFinishLEAdvertising(hc, 0);
+        return;
+    }
+    if(!bSubmitLEAdvertisingStep(hc))
+        bFinishLEAdvertising(hc, BTIOERR_HOSTERROR);
+}
+
+static BOOL bSubmitLEAdvertisingStep(struct BtHWCore *hc)
+{
+    UBYTE params[32];
+    static const UBYTE zeroaddr[6] = {0, 0, 0, 0, 0, 0};
+    struct bt_buf_writer w;
+    struct BtGATTLocalService *service = hc->hc_AdvService;
+
+    memset(params, 0, sizeof(params));
+    switch(hc->hc_AdvStep) {
+    case 0:
+        params[0] = 0;
+        return(bSubmitCmd(hc, HC_OP_LE_SET_ADV_ENABLE, params, 1, bLEAdvertisingCB, hc));
+    case 1:
+        bt_buf_writer_init(&w, params, 15);
+        bt_buf_writer_write_le16(&w, 0x00a0); /* 100 ms */
+        bt_buf_writer_write_le16(&w, 0x00f0); /* 150 ms */
+        bt_buf_writer_write_u8(&w, 0x00);     /* connectable undirected */
+        bt_buf_writer_write_u8(&w, 0x00);     /* public own address */
+        bt_buf_writer_write_u8(&w, 0x00);     /* peer address type, unused */
+        bt_buf_writer_write_bytes(&w, zeroaddr, sizeof(zeroaddr));
+        bt_buf_writer_write_u8(&w, 0x07);     /* channels 37, 38, 39 */
+        bt_buf_writer_write_u8(&w, 0x00);     /* accept all */
+        return(bSubmitCmd(hc, HC_OP_LE_SET_ADV_PARAMETERS, params, 15, bLEAdvertisingCB, hc));
+    case 2:
+        params[0] = service->bgs_AdvertisingLen;
+        CopyMem(service->bgs_Advertising, &params[1], service->bgs_AdvertisingLen);
+        return(bSubmitCmd(hc, HC_OP_LE_SET_ADV_DATA, params, 32, bLEAdvertisingCB, hc));
+    case 3:
+        params[0] = service->bgs_ScanResponseLen;
+        CopyMem(service->bgs_ScanResponse, &params[1], service->bgs_ScanResponseLen);
+        return(bSubmitCmd(hc, HC_OP_LE_SET_SCAN_RSP_DATA, params, 32, bLEAdvertisingCB, hc));
+    case 4:
+        params[0] = 1;
+        return(bSubmitCmd(hc, HC_OP_LE_SET_ADV_ENABLE, params, 1, bLEAdvertisingCB, hc));
+    }
+    return(FALSE);
+}
+
+LONG bSetLEAdvertising(struct BtHWCore *hc, struct BtGATTLocalService *service,
+                       BOOL enable)
+{
+    struct BtHardware *bth = hc->hc_Hardware;
+
+    if(!(bth->bth_Flags & BTHF_LE) || (bth->bth_State != BHS_READY))
+        return(BTIOERR_NOTREADY);
+    if(hc->hc_AdvBusy) return(IOERR_UNITBUSY);
+    if(enable) {
+        if(!service || (service->bgs_Hardware && service->bgs_Hardware != bth) ||
+           (bth->bth_LocalGATTService && bth->bth_LocalGATTService != service))
+            return(IOERR_UNITBUSY);
+        if(hc->hc_AutoConnArmed || hc->hc_Connecting || hc->hc_LEScanActive)
+            return(IOERR_UNITBUSY);
+    } else if(!service || bth->bth_LocalGATTService != service) {
+        return(BTIOERR_BADPARAMS);
+    }
+    bBgScanStop(hc);
+    hc->hc_AdvService = service;
+    hc->hc_AdvEnable = enable;
+    hc->hc_AdvWasActive = (bth->bth_LocalGATTService == service);
+    hc->hc_AdvStep = 0;
+    hc->hc_AdvBusy = TRUE;
+    if(!bSubmitLEAdvertisingStep(hc)) {
+        hc->hc_AdvBusy = FALSE;
+        hc->hc_AdvService = NULL;
+        return(BTIOERR_HOSTERROR);
+    }
+    return(0);
+}
+
+static LONG bNotifyLocalGATT(struct BtHWCore *hc, struct BtDevice *bd,
+                             struct BtGATTNotifyParams *params)
+{
+    struct BtHWConn *cn;
+    UBYTE i;
+    bt_status_t st;
+    if(!bd || !params || !params->bgn_Characteristic || !params->bgn_Data ||
+       !params->bgn_Length)
+        return(BTIOERR_BADPARAMS);
+    cn = bd->bd_Conns[1];
+    if(!cn || (cn->cn_State != HCNS_CONNECTED) || (cn->cn_Role != BDR_PERIPHERAL))
+        return(BTIOERR_NOTCONNECTED);
+    for(i = 0; i < cn->cn_GATTBindingCount; i++) {
+        if(cn->cn_GATTBindings[i].bgb_Characteristic == params->bgn_Characteristic) {
+            st = bt_gatt_server_notify(&cn->cn_GATTServer,
+                                        cn->cn_GATTBindings[i].bgb_ValueHandle,
+                                        params->bgn_Data, params->bgn_Length, bNowUS(hc));
+            return(st == BT_OK ? 0 : BTIOERR_HOSTERROR);
+        }
+    }
+    return(BTIOERR_NOTSUPPORTED);
+}
