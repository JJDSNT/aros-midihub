+/* *** Local GATT services (peripheral role) *** */
+
+/* /// "btAddGATTServiceA()" */
+AROS_LH1(APTR, btAddGATTServiceA,
+         AROS_LHA(struct TagItem *, tags, A0),
+         LIBBASETYPEPTR, BluetoothBase, 90, bt)
+{
+    AROS_LIBFUNC_INIT
+    struct BtGATTLocalService *service;
+    const UBYTE *uuid = (const UBYTE *) GetTagData(BGSRA_UUID, 0, tags);
+    const UBYTE *adv = (const UBYTE *) GetTagData(BGSRA_AdvertisingData, 0, tags);
+    const UBYTE *scan = (const UBYTE *) GetTagData(BGSRA_ScanResponse, 0, tags);
+    ULONG advlen = GetTagData(BGSRA_AdvertisingLength, 0, tags);
+    ULONG scanlen = GetTagData(BGSRA_ScanResponseLength, 0, tags);
+
+    if(!uuid || (advlen > 31) || (scanlen > 31) || (advlen && !adv) || (scanlen && !scan)) {
+        return(NULL);
+    }
+    service = btAllocVec(sizeof(*service));
+    if(!service) {
+        return(NULL);
+    }
+    CopyMem((APTR) uuid, service->bgs_UUID, 16);
+    if(advlen) CopyMem((APTR) adv, service->bgs_Advertising, advlen);
+    if(scanlen) CopyMem((APTR) scan, service->bgs_ScanResponse, scanlen);
+    service->bgs_AdvertisingLen = advlen;
+    service->bgs_ScanResponseLen = scanlen;
+    NewList(&service->bgs_Characteristics);
+    btLockWriteBase();
+    AddTail(&BluetoothBase->bt_GATTServices, &service->bgs_Node);
+    btUnlockBase();
+    return(service);
+    AROS_LIBFUNC_EXIT
+}
+/* \\\ */
+
+/* /// "btRemGATTService()" */
+AROS_LH1(void, btRemGATTService,
+         AROS_LHA(APTR, ptr, A0),
+         LIBBASETYPEPTR, BluetoothBase, 91, bt)
+{
+    AROS_LIBFUNC_INIT
+    struct BtGATTLocalService *service = ptr;
+    if(!service) return;
+    if(service->bgs_Hardware || service->bgs_UseCnt || !IsListEmpty(&service->bgs_Characteristics)) {
+        btAddErrorMsg0(RETURN_WARN, (STRPTR) GM_UNIQUENAME(libname),
+                       "GATT service is still enabled, connected, or has characteristics.");
+        return;
+    }
+    btLockWriteBase();
+    Remove(&service->bgs_Node);
+    btUnlockBase();
+    btFreeVec(service);
+    AROS_LIBFUNC_EXIT
+}
+/* \\\ */
+
+/* /// "btAddGATTCharacteristicA()" */
+AROS_LH2(APTR, btAddGATTCharacteristicA,
+         AROS_LHA(APTR, serviceptr, A0),
+         AROS_LHA(struct TagItem *, tags, A1),
+         LIBBASETYPEPTR, BluetoothBase, 92, bt)
+{
+    AROS_LIBFUNC_INIT
+    struct BtGATTLocalService *service = serviceptr;
+    struct BtGATTLocalCharacteristic *characteristic;
+    const UBYTE *uuid = (const UBYTE *) GetTagData(BGCRA_UUID, 0, tags);
+    ULONG props = GetTagData(BGCRA_Properties, 0, tags);
+    ULONG perms = GetTagData(BGCRA_Permissions, 0, tags);
+    if(!service || !uuid || service->bgs_Hardware || service->bgs_UseCnt ||
+       (props & ~0x3e) || (perms & ~(BGPM_READ|BGPM_WRITE))) {
+        return(NULL);
+    }
+    characteristic = btAllocVec(sizeof(*characteristic));
+    if(!characteristic) return(NULL);
+    characteristic->bgc_Service = service;
+    CopyMem((APTR) uuid, characteristic->bgc_UUID, 16);
+    characteristic->bgc_Properties = props;
+    characteristic->bgc_Permissions = perms;
+    characteristic->bgc_WritePort = (struct MsgPort *) GetTagData(BGCRA_WritePort, 0, tags);
+    btLockWriteBase();
+    AddTail(&service->bgs_Characteristics, &characteristic->bgc_Node);
+    btUnlockBase();
+    return(characteristic);
+    AROS_LIBFUNC_EXIT
+}
+/* \\\ */
+
+/* /// "btRemGATTCharacteristic()" */
+AROS_LH1(void, btRemGATTCharacteristic,
+         AROS_LHA(APTR, ptr, A0),
+         LIBBASETYPEPTR, BluetoothBase, 93, bt)
+{
+    AROS_LIBFUNC_INIT
+    struct BtGATTLocalCharacteristic *characteristic = ptr;
+    if(!characteristic) return;
+    if(characteristic->bgc_Service->bgs_Hardware || characteristic->bgc_Service->bgs_UseCnt) {
+        btAddErrorMsg0(RETURN_WARN, (STRPTR) GM_UNIQUENAME(libname),
+                       "GATT characteristic belongs to an active service.");
+        return;
+    }
+    btLockWriteBase();
+    Remove(&characteristic->bgc_Node);
+    btUnlockBase();
+    btFreeVec(characteristic);
+    AROS_LIBFUNC_EXIT
+}
+/* \\\ */
+
+/* /// "btSetGATTServiceEnabled()" */
+AROS_LH3(BOOL, btSetGATTServiceEnabled,
+         AROS_LHA(APTR, serviceptr, A0),
+         AROS_LHA(APTR, hardwareptr, A1),
+         AROS_LHA(BOOL, enabled, D0),
+         LIBBASETYPEPTR, BluetoothBase, 94, bt)
+{
+    AROS_LIBFUNC_INIT
+    struct BtGATTLocalService *service = serviceptr;
+    struct BtHardware *bth = hardwareptr;
+    LONG err = 0;
+    if(!service || !bth || !(bth->bth_Flags & BTHF_LE) ||
+       IsListEmpty(&service->bgs_Characteristics)) return(FALSE);
+    if(enabled) {
+        if(service->bgs_Hardware || (bth->bth_LocalGATTService && bth->bth_LocalGATTService != service))
+            return(FALSE);
+        return(bSubmitCtrl(BluetoothBase, bth, NULL, BTPRI_SETLEADV, 1, 0,
+                           service, sizeof(*service), &err));
+    }
+    if((service->bgs_Hardware != bth) || service->bgs_UseCnt) return(FALSE);
+    return(bSubmitCtrl(BluetoothBase, bth, NULL, BTPRI_SETLEADV, 0, 0,
+                       service, sizeof(*service), &err));
+    AROS_LIBFUNC_EXIT
+}
+/* \\\ */
+
+/* /// "btGATTNotify()" */
+AROS_LH4(LONG, btGATTNotify,
+         AROS_LHA(APTR, characteristicptr, A0),
+         AROS_LHA(APTR, deviceptr, A1),
+         AROS_LHA(APTR, data, A2),
+         AROS_LHA(ULONG, length, D0),
+         LIBBASETYPEPTR, BluetoothBase, 95, bt)
+{
+    AROS_LIBFUNC_INIT
+    struct BtGATTLocalCharacteristic *characteristic = characteristicptr;
+    struct BtDevice *bd = deviceptr;
+    struct BtGATTNotifyParams params;
+    LONG err = 0;
+    if(!characteristic || !bd || !data || !length ||
+       characteristic->bgc_Service->bgs_Hardware != bd->bd_Hardware)
+        return(BTIOERR_BADPARAMS);
+    params.bgn_Characteristic = characteristic;
+    params.bgn_Data = data;
+    params.bgn_Length = length;
+    if(!bSubmitCtrl(BluetoothBase, bd->bd_Hardware, bd, BTPRI_GATTNOTIFY,
+                    0, 0, &params, sizeof(params), &err)) return(err);
+    return(0);
+    AROS_LIBFUNC_EXIT
+}
+/* \\\ */
+
+/* /// "btFreeGATTWriteMsg()" */
+AROS_LH1(void, btFreeGATTWriteMsg,
+         AROS_LHA(struct BtGATTWriteMsg *, msg, A0),
+         LIBBASETYPEPTR, BluetoothBase, 96, bt)
+{
+    AROS_LIBFUNC_INIT
+    struct BtDevice *bd;
+    if(!msg) return;
+    bd = msg->bgwm_Device;
+    btFreeVec(msg);
+    if(bd) {
+        Forbid();
+        if(!(--bd->bd_UseCnt) && (bd->bd_Flags & BDFF_DELEXPUNGE)) {
+            Permit();
+            bFreeDevice(BluetoothBase, bd);
+        } else {
+            Permit();
+        }
+    }
+    AROS_LIBFUNC_EXIT
+}
+/* \\\ */
