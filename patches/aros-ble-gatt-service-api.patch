+static bool bLocalGATTWrite(void *user_data, const uint8_t *value, size_t value_len)
+{
+    struct BtGATTServerBinding *binding = user_data;
+    struct BtGATTLocalCharacteristic *characteristic = binding->bgb_Characteristic;
+    struct BtDevice *bd = binding->bgb_Conn->cn_Device;
+    struct BtGATTWriteMsg *msg;
+    if(!characteristic->bgc_WritePort) return(true);
+    msg = btAllocVec(sizeof(*msg) + value_len);
+    if(!msg) return(false);
+    msg->bgwm_Message.mn_Node.ln_Type = NT_MESSAGE;
+    msg->bgwm_Message.mn_Length = sizeof(*msg) + value_len;
+    msg->bgwm_Characteristic = characteristic;
+    msg->bgwm_Device = bd;
+    msg->bgwm_Length = value_len;
+    if(value_len) CopyMem((APTR) value, msg->bgwm_Data, value_len);
+    Forbid();
+    bd->bd_UseCnt++;
+    Permit();
+    PutMsg(characteristic->bgc_WritePort, &msg->bgwm_Message);
+    return(true);
+}
+
+static BOOL bStartLocalGATTServer(struct BtHWConn *cn)
+{
+    struct BtGATTLocalService *service = cn->cn_Core->hc_Hardware->bth_LocalGATTService;
+    struct BtGATTLocalCharacteristic *characteristic;
+    UBYTE uuid[16];
+    UWORD service_handle;
+    ULONG i;
+    bt_status_t st;
+    if(!service) return(FALSE);
+    bt_gatt_server_init(&cn->cn_GATTServer, &cn->cn_L2CAP);
+    for(i = 0; i < 16; i++) uuid[i] = service->bgs_UUID[15 - i];
+    st = bt_gatt_server_add_service(&cn->cn_GATTServer, uuid, 16, &service_handle);
+    (void) service_handle;
+    if(st != BT_OK) return(FALSE);
+    cn->cn_GATTBindingCount = 0;
+    for(characteristic = (struct BtGATTLocalCharacteristic *) service->bgs_Characteristics.lh_Head;
+        characteristic->bgc_Node.ln_Succ;
+        characteristic = (struct BtGATTLocalCharacteristic *) characteristic->bgc_Node.ln_Succ) {
+        struct BtGATTServerBinding *binding;
+        UWORD value_handle;
+        if(cn->cn_GATTBindingCount == HC_MAX_GATT_SERVER_BINDINGS) return(FALSE);
+        binding = &cn->cn_GATTBindings[cn->cn_GATTBindingCount];
+        binding->bgb_Conn = cn;
+        binding->bgb_Characteristic = characteristic;
+        for(i = 0; i < 16; i++) uuid[i] = characteristic->bgc_UUID[15 - i];
+        st = bt_gatt_server_add_characteristic(&cn->cn_GATTServer, uuid, 16,
+                 characteristic->bgc_Properties, characteristic->bgc_Permissions,
+                 NULL, bLocalGATTWrite, binding, &value_handle);
+        if(st != BT_OK) return(FALSE);
+        binding->bgb_ValueHandle = value_handle;
+        if(characteristic->bgc_Properties & (BGCP_NOTIFY|BGCP_INDICATE)) {
+            st = bt_gatt_server_add_cccd(&cn->cn_GATTServer, value_handle, NULL);
+            if(st != BT_OK) return(FALSE);
+        }
+        cn->cn_GATTBindingCount++;
+    }
+    if(bt_gatt_server_start(&cn->cn_GATTServer) != BT_OK) return(FALSE);
+    service->bgs_UseCnt++;
+    return(TRUE);
+}
