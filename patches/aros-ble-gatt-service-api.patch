+/* Local GATT services. UUID byte arrays use the same canonical big-endian
+   representation as BSVA_UUID and BEA_UUID. A service currently owns one or
+   more characteristics and may be advertised by one radio at a time. */
+#define BGSRA_Dummy              (BT_TAGBASE + 0xe00)
+#define BGSRA_UUID               (BGSRA_Dummy + 0x01) /* UBYTE *16, required */
+#define BGSRA_AdvertisingData    (BGSRA_Dummy + 0x02) /* UBYTE *, up to 31 bytes */
+#define BGSRA_AdvertisingLength  (BGSRA_Dummy + 0x03) /* ULONG */
+#define BGSRA_ScanResponse       (BGSRA_Dummy + 0x04) /* UBYTE *, up to 31 bytes */
+#define BGSRA_ScanResponseLength (BGSRA_Dummy + 0x05) /* ULONG */
+
+#define BGCRA_Dummy              (BT_TAGBASE + 0xf00)
+#define BGCRA_UUID               (BGCRA_Dummy + 0x01) /* UBYTE *16, required */
+#define BGCRA_Properties         (BGCRA_Dummy + 0x02) /* ULONG BGCP_xxx */
+#define BGCRA_Permissions        (BGCRA_Dummy + 0x03) /* ULONG BGPM_xxx */
+#define BGCRA_WritePort          (BGCRA_Dummy + 0x04) /* struct MsgPort *, optional */
+
+#define BGCP_READ                  0x02
+#define BGCP_WRITEWITHOUTRESPONSE  0x04
+#define BGCP_WRITE                 0x08
+#define BGCP_NOTIFY                0x10
+#define BGCP_INDICATE              0x20
+#define BGPM_READ                   0x01
+#define BGPM_WRITE                  0x02
+
+struct BtGATTWriteMsg
+{
+    struct Message bgwm_Message;
+    APTR bgwm_Characteristic;
+    APTR bgwm_Device;
+    ULONG bgwm_Length;
+    UBYTE bgwm_Data[1];
+};
+
 #define BDSA_Dummy           (BT_TAGBASE + 0xb00)
 #define BDSA_Duration        (BDSA_Dummy + 0x01) /* ULONG seconds (default BGCA_DiscoveryTime) */
