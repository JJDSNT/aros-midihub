diff --git a/workbench/libs/camd/camdendpoint.h b/workbench/libs/camd/camdendpoint.h
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/camdendpoint.h
@@ -0,0 +1,138 @@
+#ifndef MIDI_CAMDENDPOINT_H
+#define MIDI_CAMDENDPOINT_H
+
+/*
+ * CAMD endpoint client records.
+ *
+ * PROVISIONAL: this is the camd.library 43 client surface under review.
+ * Names, values and layouts can still change. Every record starts with Size
+ * and Version, holds no pointers and has the same layout on every target.
+ */
+
+#ifdef __AROS__
+#   include <exec/types.h>
+#else
+#   include <stdint.h>
+typedef uint32_t ULONG;
+typedef uint8_t UBYTE;
+#endif
+
+#define CAMD_ENDPOINT_NAME_BYTES       128u
+#define CAMD_ENDPOINT_PRODUCT_BYTES    128u
+#define CAMD_ENDPOINT_TRANSPORT_BYTES   32u
+
+/* The container a session carries, fixed when it is opened. */
+#define CAMD_DATA_FORMAT_MIDI1           (1u << 0)
+#define CAMD_DATA_FORMAT_UMP             (1u << 1)
+#define CAMD_DATA_FORMAT_ALL             (CAMD_DATA_FORMAT_MIDI1 | \
+                                          CAMD_DATA_FORMAT_UMP)
+
+/* The MIDI protocol carried in that container. */
+#define CAMD_PROTOCOL_MIDI1              1u
+#define CAMD_PROTOCOL_MIDI2              2u
+
+/* A session has exactly one direction. */
+#define CAMD_DIRECTION_INPUT             (1u << 0)
+#define CAMD_DIRECTION_OUTPUT            (1u << 1)
+
+/* CAMDSessionRequestV1.Conversion. Only CAMD_CONVERSION_NONE exists yet. */
+#define CAMD_CONVERSION_NONE             0u
+
+/* A runtime capability, passed by address and never stored on disk. All
+ * zero is invalid. */
+struct CAMDHandleV1 {
+    ULONG slot;
+    ULONG generation;
+};
+
+/* An opaque stable system ID: compare or store all 16 bytes. */
+struct CAMDEndpointIDV1 {
+    ULONG word[4];
+};
+
+struct CAMDGenerationV1 {
+    ULONG high;
+    ULONG low;
+};
+
+enum CAMDEndpointStateV1 {
+    CAMD_ENDPOINT_REGISTERED = 1,
+    CAMD_ENDPOINT_DISCOVERING,
+    CAMD_ENDPOINT_AVAILABLE,
+    CAMD_ENDPOINT_OFFLINE,
+    CAMD_ENDPOINT_RETIRING,
+    CAMD_ENDPOINT_RETIRED
+};
+
+struct CAMDEndpointInfoV1 {
+    ULONG Size;
+    ULONG Version;
+    struct CAMDEndpointIDV1 ID;
+    struct CAMDEndpointIDV1 ProviderID;
+    ULONG State;
+    ULONG Flags;
+    ULONG IdentityKind;
+    ULONG NativeDataFormats;
+    ULONG ProtocolCapabilities;
+    ULONG CurrentProtocol;
+    struct CAMDGenerationV1 Generation;
+    char Name[CAMD_ENDPOINT_NAME_BYTES];
+    char ProductInstance[CAMD_ENDPOINT_PRODUCT_BYTES];
+    char Transport[CAMD_ENDPOINT_TRANSPORT_BYTES];
+};
+
+/* What the endpoint functions return. */
+enum CAMDRegistryResult {
+    CAMD_REGISTRY_OK = 0,
+    CAMD_REGISTRY_INVALID,
+    CAMD_REGISTRY_NOMEM,
+    CAMD_REGISTRY_DUPLICATE,
+    CAMD_REGISTRY_STALE,
+    CAMD_REGISTRY_STATE,
+    CAMD_REGISTRY_RETIRED,
+    CAMD_REGISTRY_RANGE,
+    CAMD_REGISTRY_EMPTY,
+    CAMD_REGISTRY_BUSY,
+    CAMD_REGISTRY_CALLBACK_FAILED,
+    CAMD_REGISTRY_UNSUPPORTED,
+    CAMD_REGISTRY_QUEUE_FULL,
+    CAMD_REGISTRY_TOO_LARGE
+};
+
+/* A complete non-SysEx MIDI 1.0 message. Bytes are in wire order and Length
+ * is 1..3. Running status never crosses an event boundary. */
+struct CAMDMIDI1EventV1 {
+    ULONG Size;
+    ULONG Version;
+    ULONG Length;
+    UBYTE Bytes[4];
+    ULONG Flags;
+    ULONG TimeHigh;
+    ULONG TimeLow;
+    ULONG ClockDomain;
+};
+
+/* QueueCapacity is the least number of native records to reserve. */
+struct CAMDSessionRequestV1 {
+    ULONG Size;
+    ULONG Version;
+    struct CAMDEndpointIDV1 EndpointID;
+    ULONG Direction;
+    ULONG DataFormat;
+    ULONG Protocol;
+    ULONG Conversion;
+    ULONG QueueCapacity;
+};
+
+/* What an open session got. MaxSysExBytes is zero for UMP. */
+struct CAMDSessionInfoV1 {
+    ULONG Size;
+    ULONG Version;
+    ULONG Direction;
+    ULONG DataFormat;
+    ULONG Protocol;
+    ULONG QueueCapacity;
+    ULONG MaxSysExBytes;
+};
+
+#endif
diff --git a/workbench/libs/camd/closeendpointsession.c b/workbench/libs/camd/closeendpointsession.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/closeendpointsession.c
@@ -0,0 +1,56 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+#include "provider_contract.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH1(LONG, CloseEndpointSession,
+
+/*  SYNOPSIS */
+	AROS_LHA(struct CAMDHandleV1 *, session, A0),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 50, Camd)
+
+/*  FUNCTION
+		Closes a session. Messages not yet sent are dropped; call
+		DrainEndpointSession() first to have them sent.
+
+    INPUTS
+		session - from OpenEndpointSession().
+
+    RESULT
+		CAMD_REGISTRY_OK, CAMD_REGISTRY_STALE for a session already
+		closed, or another CAMD_REGISTRY_ value.
+
+    NOTES
+		New in V43 and provisional: the endpoint functions can still
+		change.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		OpenEndpointSession(), DrainEndpointSession()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	if(session==NULL) return CAMD_REGISTRY_INVALID;
+
+	return camd_registry_session_close(CB(CamdBase)->EndpointRegistry,*session);
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/camd/drainendpointsession.c b/workbench/libs/camd/drainendpointsession.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/drainendpointsession.c
@@ -0,0 +1,66 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+#include "provider_contract.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH1(LONG, DrainEndpointSession,
+
+/*  SYNOPSIS */
+	AROS_LHA(struct CAMDHandleV1 *, session, A0),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 53, Camd)
+
+/*  FUNCTION
+		Waits until everything queued on an output session has been
+		handed to its port.
+
+    INPUTS
+		session - from OpenEndpointSession().
+
+    RESULT
+		CAMD_REGISTRY_OK, or another CAMD_REGISTRY_ value.
+
+    NOTES
+		New in V43 and provisional: the endpoint functions can still
+		change. Waits as long as the port takes, like PutSysEx().
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		PutEndpointMidi(), CloseEndpointSession()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	LONG result;
+
+	if(session==NULL) return CAMD_REGISTRY_INVALID;
+
+	/* The session's worker empties the queue; QUEUE_FULL means it still
+	   has something to hand over. */
+	for(;;){
+		result=camd_registry_session_drain(CB(CamdBase)->EndpointRegistry,
+			*session);
+		if(result!=CAMD_REGISTRY_QUEUE_FULL) break;
+		CamdWait();
+	}
+
+	return result;
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/camd/endpoint_client.c b/workbench/libs/camd/endpoint_client.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/endpoint_client.c
@@ -0,0 +1,76 @@
+/*
+ * Snapshot handles of the endpoint client functions.
+ *
+ * A client holds a slot and a generation, never the snapshot's address, so a
+ * stale or foreign handle is refused instead of followed.
+ */
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+
+LONG AddEndpointSnapshot(struct CAMDEndpointSnapshot *snapshot,
+                         struct CAMDHandleV1 *handle,
+                         struct CamdBase *CamdBase)
+{
+    struct CamdBase_intern *base = CB(CamdBase);
+    LONG result = CAMD_REGISTRY_NOMEM;
+    ULONG i;
+
+    ObtainSemaphore(&base->EndpointClientSemaphore);
+    for (i = 0; i < ENDPOINT_SNAPSHOTS; ++i) {
+        if (base->EndpointSnapshots[i] == NULL) {
+            if (++base->EndpointSnapshotGenerations[i] == 0)
+                ++base->EndpointSnapshotGenerations[i];
+            base->EndpointSnapshots[i] = snapshot;
+            handle->slot = i;
+            handle->generation = base->EndpointSnapshotGenerations[i];
+            result = CAMD_REGISTRY_OK;
+            break;
+        }
+    }
+    ReleaseSemaphore(&base->EndpointClientSemaphore);
+    return result;
+}
+
+/* EndpointClientSemaphore must be held; the snapshot is good while it is. */
+struct CAMDEndpointSnapshot *FindEndpointSnapshot(
+    const struct CAMDHandleV1 *handle, struct CamdBase *CamdBase)
+{
+    struct CamdBase_intern *base = CB(CamdBase);
+
+    if (handle->slot >= ENDPOINT_SNAPSHOTS || handle->generation == 0 ||
+        base->EndpointSnapshotGenerations[handle->slot] != handle->generation)
+        return NULL;
+    return base->EndpointSnapshots[handle->slot];
+}
+
+void RemoveEndpointSnapshot(const struct CAMDHandleV1 *handle,
+                            struct CamdBase *CamdBase)
+{
+    struct CamdBase_intern *base = CB(CamdBase);
+    struct CAMDEndpointSnapshot *snapshot;
+
+    ObtainSemaphore(&base->EndpointClientSemaphore);
+    snapshot = FindEndpointSnapshot(handle, CamdBase);
+    if (snapshot != NULL)
+        base->EndpointSnapshots[handle->slot] = NULL;
+    ReleaseSemaphore(&base->EndpointClientSemaphore);
+    if (snapshot != NULL)
+        camd_snapshot_destroy(snapshot);
+}
+
+/* Snapshots a client did not release. CAMD must be expunging. */
+void FreeEndpointSnapshots(struct CamdBase *CamdBase)
+{
+    struct CamdBase_intern *base = CB(CamdBase);
+    ULONG i;
+
+    for (i = 0; i < ENDPOINT_SNAPSHOTS; ++i) {
+        if (base->EndpointSnapshots[i] != NULL) {
+            camd_snapshot_destroy(base->EndpointSnapshots[i]);
+            base->EndpointSnapshots[i] = NULL;
+        }
+    }
+}
