+    if (!backend || !session || session->backend != backend ||
+        session->direction != CAMD_PROVIDER_DIRECTION_INPUT)
+        return CAMD_PROVIDER_INVALID;
+    lock_acquire(&backend->lock);
+    session->receiving = 0;
+    lock_release(&backend->lock);
+    return CAMD_PROVIDER_OK;
+}
