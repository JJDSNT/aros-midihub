+        unsigned int timeout = 100000;
+        while (timeout-- && !(uart[0x14/4] & (1 << 5))) ;
+    }
+    else
+        while (uart[0x18/4] & (1 << 5)) ; /* wait for TXFF clear */
     uart[0] = c;
 }
+
+static inline void uart_putc(char c)
+{
+    volatile uint32_t *uart = (volatile uint32_t *)krn_dbg_uart;
+    if (c == '\n')
