diff --git a/workbench/libs/camd/forgetendpointidentity.c b/workbench/libs/camd/forgetendpointidentity.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/forgetendpointidentity.c
@@ -0,0 +1,63 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH1(LONG, ForgetEndpointIdentity,
+
+/*  SYNOPSIS */
+	AROS_LHA(struct CAMDEndpointIDV1 *, id, A0),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 76, Camd)
+
+/*  FUNCTION
+		Removes a stored endpoint ID. What it was stored for, a
+		published name or a driver's port, gets a new ID the next time
+		it appears. Saved routes that name the old ID no longer find
+		anything.
+
+    INPUTS
+		id - the ID to forget.
+
+    RESULT
+		CAMD_RESULT_OK; CAMD_RESULT_BUSY while an endpoint or what
+		offers it has the ID; CAMD_RESULT_STALE when no such ID is
+		stored; CAMD_RESULT_WRONG_STATE when the store is unreadable;
+		CAMD_RESULT_FAILED when the store could not be written, in
+		which case the ID stays.
+
+    NOTES
+		New in V43 and provisional: the endpoint functions can still
+		change.
+		An endpoint and what offers it, a driver or a publisher, have
+		an ID each: forget both to start afresh. A loaded driver's IDs
+		stay in use until the library is expunged.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		GetStoredEndpointIdentity()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	if(id==NULL) return camd_public_result(CAMD_REGISTRY_INVALID);
+
+	return camd_public_result(ForgetStoredIdentity(id,CamdBase));
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/camd/getendpointidentitystore.c b/workbench/libs/camd/getendpointidentitystore.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/getendpointidentitystore.c
@@ -0,0 +1,68 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH1(LONG, GetEndpointIdentityStore,
+
+/*  SYNOPSIS */
+	AROS_LHA(struct CAMDIdentityStoreInfoV1 *, info, A0),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 74, Camd)
+
+/*  FUNCTION
+		Tells how the store of endpoint IDs was found when camd.library
+		started, how many IDs it holds and how many it can hold.
+
+    INPUTS
+		info - Size and Version set by the caller. At most Size bytes
+		    are written, and Size is then the size of the full record.
+
+    RESULT
+		CAMD_RESULT_OK, or CAMD_RESULT_INVALID.
+
+    NOTES
+		New in V43 and provisional: the endpoint functions can still
+		change.
+		With CAMD_IDENTITY_STORE_UNREADABLE every endpoint has a
+		temporary ID and the files in ENVARC:Sys are left untouched,
+		for whoever wants to look at them. Removing them gives a new
+		store, and new IDs, the next time the library starts.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		GetStoredEndpointIdentity(), ForgetEndpointIdentity()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	struct CAMDIdentityStoreInfoV1 full;
+	ULONG size;
+
+	if(info==NULL || info->Size<2*sizeof(ULONG) || info->Version!=1){
+		return camd_public_result(CAMD_REGISTRY_INVALID);
+	}
+	ReadIdentityStore(&full,CamdBase);
+	size=info->Size<sizeof(full) ? info->Size : sizeof(full);
+	CopyMem(&full,info,size);
+	info->Size=sizeof(full);
+
+	return camd_public_result(CAMD_REGISTRY_OK);
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/camd/getstoredendpointidentity.c b/workbench/libs/camd/getstoredendpointidentity.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/getstoredendpointidentity.c
@@ -0,0 +1,75 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH2(LONG, GetStoredEndpointIdentity,
+
+/*  SYNOPSIS */
+	AROS_LHA(ULONG, index, D0),
+	AROS_LHA(struct CAMDStoredIdentityV1 *, identity, A0),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 75, Camd)
+
+/*  FUNCTION
+		Reads one of the stored endpoint IDs and what it is stored
+		for: a published endpoint's name, or a driver's file name and
+		port.
+
+    INPUTS
+		index - from 0; see GetEndpointIdentityStore() for how many.
+		identity - Size and Version set by the caller. At most Size
+		    bytes are written, and Size is then the size of the full
+		    record.
+
+    RESULT
+		CAMD_RESULT_OK, CAMD_RESULT_OUT_OF_RANGE past the last one, or
+		CAMD_RESULT_INVALID.
+
+    NOTES
+		New in V43 and provisional: the endpoint functions can still
+		change.
+		The order means nothing and changes when an ID is forgotten
+		or added: read them all in one go, and forget by ID.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		GetEndpointIdentityStore(), ForgetEndpointIdentity()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	struct CAMDStoredIdentityV1 full;
+	ULONG size;
+	LONG result;
+
+	if(identity==NULL || identity->Size<2*sizeof(ULONG) ||
+	   identity->Version!=1){
+		return camd_public_result(CAMD_REGISTRY_INVALID);
+	}
+	result=ReadStoredIdentity(index,&full,CamdBase);
+	if(result==CAMD_REGISTRY_OK){
+		size=identity->Size<sizeof(full) ? identity->Size : sizeof(full);
+		CopyMem(&full,identity,size);
+		identity->Size=sizeof(full);
+	}
+
+	return camd_public_result(result);
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/camd/identity_map.c b/workbench/libs/camd/identity_map.c
--- a/workbench/libs/camd/identity_map.c
+++ b/workbench/libs/camd/identity_map.c
@@ -331,3 +331,74 @@ enum CAMDIdentityMapResult camd_identity_map_resolve(
     lock_release(&map->lock);
     return CAMD_IDENTITY_MAP_OK;
 }
+
+uint32_t camd_identity_map_count(struct CAMDIdentityMap *map)
+{
+    uint32_t count;
+
+    if (!map)
+        return 0;
+    lock_acquire(&map->lock);
+    count = map->count;
+    lock_release(&map->lock);
+    return count;
+}
+
+uint32_t camd_identity_map_capacity(struct CAMDIdentityMap *map)
+{
+    return map ? map->capacity : 0;
+}
+
+enum CAMDIdentityMapResult camd_identity_map_get(
+    struct CAMDIdentityMap *map, uint32_t index,
+    struct CAMDIdentityRecordV1 *record, uint32_t *persistent)
+{
+    enum CAMDIdentityMapResult result = CAMD_IDENTITY_MAP_MISSING;
+
+    if (!map || !record)
+        return CAMD_IDENTITY_MAP_INVALID;
+    lock_acquire(&map->lock);
+    if (index < map->count) {
+        *record = map->entries[index].record;
+        if (persistent)
+            *persistent = map->entries[index].persistent ? 1u : 0u;
+        result = CAMD_IDENTITY_MAP_OK;
+    }
+    lock_release(&map->lock);
+    return result;
+}
+
+enum CAMDIdentityMapResult camd_identity_map_remove(
+    struct CAMDIdentityMap *map, const struct CAMDEndpointIDV1 *id)
+{
+    enum CAMDIdentityMapResult result = CAMD_IDENTITY_MAP_MISSING;
+    struct identity_entry removed;
+    uint32_t i, at;
+
+    if (!map || !id || id_is_zero(id))
+        return CAMD_IDENTITY_MAP_INVALID;
+    lock_acquire(&map->lock);
+    for (at = 0; at < map->count; ++at) {
+        if (id_equal(&map->entries[at].record.ID, id))
+            break;
+    }
+    if (at < map->count) {
+        removed = map->entries[at];
+        for (i = at; i + 1 < map->count; ++i)
+            map->entries[i] = map->entries[i + 1];
+        --map->count;
+        memset(&map->entries[map->count], 0, sizeof(map->entries[0]));
+        result = CAMD_IDENTITY_MAP_OK;
+        /* What storage holds has to lose it too, or it is back next time. */
+        if (removed.persistent && !commit_all(map)) {
+            for (i = map->count; i > at; --i)
+                map->entries[i] = map->entries[i - 1];
+            map->entries[at] = removed;
+            ++map->count;
+            result = CAMD_IDENTITY_MAP_STORAGE;
+        }
+    }
+    lock_release(&map->lock);
+    return result;
+}
+
diff --git a/workbench/libs/camd/identity_map.h b/workbench/libs/camd/identity_map.h
--- a/workbench/libs/camd/identity_map.h
+++ b/workbench/libs/camd/identity_map.h
@@ -16,7 +16,9 @@ enum CAMDIdentityMapResult {
     CAMD_IDENTITY_MAP_NOMEM,
     CAMD_IDENTITY_MAP_FULL,
     CAMD_IDENTITY_MAP_COLLISION,
-    CAMD_IDENTITY_MAP_GENERATOR
+    CAMD_IDENTITY_MAP_GENERATOR,
+    CAMD_IDENTITY_MAP_MISSING,
+    CAMD_IDENTITY_MAP_STORAGE
 };
 
 enum CAMDIdentityConfidenceV1 {
@@ -91,4 +93,23 @@ enum CAMDIdentityMapResult camd_identity_map_resolve(
     struct CAMDIdentityMap *map, const struct CAMDIdentityKeyV1 *key,
     struct CAMDIdentityResolutionV1 *resolution);
 
+/* How many mappings the map holds, and how many it has room for. */
+uint32_t camd_identity_map_count(struct CAMDIdentityMap *map);
+uint32_t camd_identity_map_capacity(struct CAMDIdentityMap *map);
+
+/* A copy of mapping number index, counted from 0 in no particular order,
+ * and whether it is stored. CAMD_IDENTITY_MAP_MISSING beyond the last. The
+ * order changes when a mapping is removed. */
+enum CAMDIdentityMapResult camd_identity_map_get(
+    struct CAMDIdentityMap *map, uint32_t index,
+    struct CAMDIdentityRecordV1 *record, uint32_t *persistent);
+
+/* Forgets the mapping to this ID: its key gets a new ID the next time it is
+ * resolved. A stored mapping goes from storage first, and stays when that
+ * fails (CAMD_IDENTITY_MAP_STORAGE). CAMD_IDENTITY_MAP_MISSING when no
+ * mapping has the ID. Whether something still uses the ID is the caller's
+ * to know. */
+enum CAMDIdentityMapResult camd_identity_map_remove(
+    struct CAMDIdentityMap *map, const struct CAMDEndpointIDV1 *id);
+
 #endif
diff --git a/workbench/libs/camd/identity_store_aros.c b/workbench/libs/camd/identity_store_aros.c
--- a/workbench/libs/camd/identity_store_aros.c
+++ b/workbench/libs/camd/identity_store_aros.c
@@ -28,8 +28,48 @@ struct CAMDIdentityStoreAROS {
