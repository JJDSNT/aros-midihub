+
+/* CAMDIdentityStoreInfoV1.State. */
+#define CAMD_IDENTITY_STORE_COMPLETE     1u  /* read whole, or begun anew */
+#define CAMD_IDENTITY_STORE_RECOVERED    2u  /* read from the backup, or from
