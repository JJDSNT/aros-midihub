diff --git a/rom/bluetooth/stack/tests/gatt/test_gatt_server.c b/rom/bluetooth/stack/tests/gatt/test_gatt_server.c
new file mode 100644
index 0000000000..4f7e9f2d28
--- /dev/null
+++ b/rom/bluetooth/stack/tests/gatt/test_gatt_server.c
@@ -0,0 +1,178 @@
+#include "test_gatt_server.h"
+#include "../support/test.h"
+
+#include <btcore/gatt_server.h>
+
+#include <string.h>
+
+struct fake_transport
+{
+    struct bt_hci_transport base;
+    struct bt_l2cap_reassembler sent;
+    uint8_t pdu[600];
+    size_t pdu_len;
+    bool ready;
+};
+
+static int fake_open(struct bt_hci_transport *t) { (void)t; return 0; }
+static void fake_close(struct bt_hci_transport *t) { (void)t; }
+static int fake_unsupported(struct bt_hci_transport *t, const uint8_t *p, size_t n)
+{ (void)t; (void)p; (void)n; return -1; }
+static int fake_acl(struct bt_hci_transport *t, const uint8_t *data, size_t length)
+{
+    struct fake_transport *ft = (struct fake_transport *)t->impl;
+    struct bt_buf_reader r;
+    struct bt_hci_acl_header h;
+    enum bt_l2cap_reassembly_result rr;
+    const uint8_t *payload;
+    bt_buf_reader_init(&r, data, length);
+    if (bt_hci_parse_acl_header(&r, &h) != BT_OK) return -1;
+    payload = bt_buf_reader_peek(&r, h.data_len);
+    if (payload == NULL) return -1;
+    rr = bt_l2cap_reassembler_feed(&ft->sent, h.pb_flag, payload, h.data_len);
+    if (rr == BT_L2CAP_REASSEMBLY_COMPLETE) {
+        const uint8_t *p = bt_l2cap_reassembler_take(&ft->sent, &ft->pdu_len);
+        memcpy(ft->pdu, p, ft->pdu_len); ft->ready = true;
+    }
+    return 0;
+}
+static int fake_rx(struct bt_hci_transport *t, bt_hci_transport_recv_fn fn, void *u)
+{ (void)t; (void)fn; (void)u; return 0; }
+static void fake_stop(struct bt_hci_transport *t) { (void)t; }
+static const struct bt_hci_transport_ops fake_ops = {
+    fake_open, fake_close, fake_unsupported, fake_acl, fake_unsupported, fake_unsupported,
+    fake_rx, fake_stop
+};
+
+static void setup_transport(struct fake_transport *ft)
+{
+    memset(ft, 0, sizeof(*ft));
+    ft->base.ops = &fake_ops; ft->base.impl = ft;
+    bt_l2cap_reassembler_init(&ft->sent);
+}
+
+static bool take_att(struct fake_transport *ft, const uint8_t **data, size_t *len)
+{
+    struct bt_buf_reader r;
+    struct bt_l2cap_header h;
+    if (!ft->ready) return false;
+    ft->ready = false;
+    bt_buf_reader_init(&r, ft->pdu, ft->pdu_len);
+    if (bt_l2cap_parse_header(&r, &h) != BT_OK || h.cid != BT_L2CAP_CID_ATT) return false;
+    *data = bt_buf_reader_peek(&r, h.length); *len = h.length;
+    return *data != NULL;
+}
+
+static void feed_att(struct bt_l2cap_channel_manager *mgr, const uint8_t *att, size_t att_len)
+{
+    uint8_t l2[620], acl[624];
+    struct bt_buf_writer lw, aw;
+    struct bt_buf_reader r;
+    struct bt_hci_acl_header h;
+    bt_buf_writer_init(&lw, l2, sizeof(l2));
+    bt_l2cap_encode_header(&lw, (uint16_t)att_len, BT_L2CAP_CID_ATT);
+    bt_buf_writer_write_bytes(&lw, att, att_len);
+    bt_buf_writer_init(&aw, acl, sizeof(acl));
+    bt_hci_encode_acl_header(&aw, mgr->handle, 0, 0, (uint16_t)bt_buf_writer_len(&lw));
+    bt_buf_writer_write_bytes(&aw, l2, bt_buf_writer_len(&lw));
+    bt_buf_reader_init(&r, acl, bt_buf_writer_len(&aw));
+    bt_hci_parse_acl_header(&r, &h);
+    bt_l2cap_channel_manager_on_acl(mgr, h.pb_flag,
+        bt_buf_reader_peek(&r, h.data_len), h.data_len, 10);
+}
+
+struct write_log { int count; uint8_t data[16]; size_t len; };
+static bool on_write(void *user, const uint8_t *value, size_t value_len)
+{
+    struct write_log *log = (struct write_log *)user;
+    log->count++; log->len = value_len;
+    if (value_len <= sizeof(log->data)) memcpy(log->data, value, value_len);
+    return value_len <= sizeof(log->data);
+}
+
+static void build_server(struct bt_gatt_server *s, struct bt_l2cap_channel_manager *mgr,
+                         struct write_log *log, uint16_t *value_handle, uint16_t *cccd_handle)
+{
+    static const uint8_t service_uuid[16] = {
+        0x00,0xc7,0xc4,0x4e,0xc3,0x6c,0x51,0xa7,0x33,0x4b,0xe8,0xed,0x5a,0x0e,0xb8,0x03};
+    static const uint8_t io_uuid[16] = {
+        0xf3,0x6b,0x10,0x9d,0x66,0xf2,0xa9,0xa1,0x12,0x41,0x68,0x38,0xdb,0xe5,0x72,0x77};
+    bt_gatt_server_init(s, mgr);
+    BT_CHECK(bt_gatt_server_add_service(s, service_uuid, 16, NULL) == BT_OK);
+    BT_CHECK(bt_gatt_server_add_characteristic(s, io_uuid, 16,
+        BT_GATT_CHAR_PROP_READ | BT_GATT_CHAR_PROP_WRITE_WITHOUT_RESPONSE |
+        BT_GATT_CHAR_PROP_NOTIFY, BT_GATT_PERM_READ | BT_GATT_PERM_WRITE,
+        NULL, on_write, log, value_handle) == BT_OK);
+    BT_CHECK(bt_gatt_server_add_cccd(s, *value_handle, cccd_handle) == BT_OK);
+    BT_CHECK(bt_gatt_server_start(s) == BT_OK);
+}
+
+static void test_discovery(void)
+{
+    struct fake_transport ft;
+    struct bt_l2cap_channel_manager mgr;
+    struct bt_gatt_server s;
+    struct write_log log = {0};
+    uint16_t value_handle, cccd_handle;
+    const uint8_t *rsp; size_t rsp_len;
+    static const uint8_t group_req[] = {0x10,1,0,0xff,0xff,0x00,0x28};
+    static const uint8_t type_req[] = {0x08,1,0,0xff,0xff,0x03,0x28};
+    static const uint8_t info_req[] = {0x04,1,0,0xff,0xff};
+    setup_transport(&ft);
+    bt_l2cap_channel_manager_init(&mgr, &ft.base, 0x41, BT_L2CAP_CID_SIGNALING_LE, 200);
+    build_server(&s, &mgr, &log, &value_handle, &cccd_handle);
+
+    feed_att(&mgr, group_req, sizeof(group_req));
+    BT_CHECK(take_att(&ft, &rsp, &rsp_len));
+    BT_CHECK(rsp_len == 22 && rsp[0] == BT_ATT_OPCODE_READ_BY_GROUP_TYPE_RESPONSE);
+    BT_CHECK(rsp[1] == 20 && rsp[2] == 1 && rsp[4] == cccd_handle);
+
+    feed_att(&mgr, type_req, sizeof(type_req));
+    BT_CHECK(take_att(&ft, &rsp, &rsp_len));
+    BT_CHECK(rsp[0] == BT_ATT_OPCODE_READ_BY_TYPE_RESPONSE && rsp[1] == 21);
+    BT_CHECK(rsp[5] == (uint8_t)value_handle);
+
+    feed_att(&mgr, info_req, sizeof(info_req));
+    BT_CHECK(take_att(&ft, &rsp, &rsp_len));
+    BT_CHECK(rsp[0] == BT_ATT_OPCODE_FIND_INFORMATION_RESPONSE && rsp[1] == 1);
+    BT_CHECK(rsp_len == 10); /* response stops before UUID format changes */
+}
+
+static void test_write_subscribe_and_notify(void)
+{
+    struct fake_transport ft;
+    struct bt_l2cap_channel_manager mgr;
+    struct bt_gatt_server s;
+    struct write_log log = {0};
+    uint16_t value_handle, cccd_handle;
+    uint8_t pdu[8];
+    const uint8_t *rsp; size_t rsp_len;
+    setup_transport(&ft);
+    bt_l2cap_channel_manager_init(&mgr, &ft.base, 0x41, BT_L2CAP_CID_SIGNALING_LE, 200);
+    build_server(&s, &mgr, &log, &value_handle, &cccd_handle);
+
+    pdu[0] = BT_ATT_OPCODE_WRITE_COMMAND; pdu[1] = (uint8_t)value_handle;
+    pdu[2] = (uint8_t)(value_handle >> 8); pdu[3] = 0x80; pdu[4] = 0x90; pdu[5] = 60; pdu[6] = 100;
+    feed_att(&mgr, pdu, 7);
+    BT_CHECK(log.count == 1 && log.len == 4 && log.data[1] == 0x90);
+    BT_CHECK(!ft.ready); /* Write Command has no response */
+    BT_CHECK(!bt_gatt_server_is_subscribed(&s, value_handle));
+
+    pdu[0] = BT_ATT_OPCODE_WRITE_REQUEST; pdu[1] = (uint8_t)cccd_handle;
+    pdu[2] = (uint8_t)(cccd_handle >> 8); pdu[3] = 1; pdu[4] = 0;
+    feed_att(&mgr, pdu, 5);
+    BT_CHECK(take_att(&ft, &rsp, &rsp_len));
+    BT_CHECK(rsp_len == 1 && rsp[0] == BT_ATT_OPCODE_WRITE_RESPONSE);
+    BT_CHECK(bt_gatt_server_is_subscribed(&s, value_handle));
+
+    BT_CHECK(bt_gatt_server_notify(&s, value_handle, pdu + 3, 2, 20) == BT_OK);
+    BT_CHECK(take_att(&ft, &rsp, &rsp_len));
+    BT_CHECK(rsp_len == 5 && rsp[0] == BT_ATT_OPCODE_HANDLE_VALUE_NOTIFICATION);
+    BT_CHECK(rsp[1] == (uint8_t)value_handle && rsp[3] == 1);
+}
+
+void run_gatt_server_tests(void)
+{
+    test_discovery();
+    test_write_subscribe_and_notify();
+}
