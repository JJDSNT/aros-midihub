diff --git a/rom/bluetooth/stack/protocols/gatt/gatt_server.c b/rom/bluetooth/stack/protocols/gatt/gatt_server.c
new file mode 100644
index 0000000000..a72bf1686d
--- /dev/null
+++ b/rom/bluetooth/stack/protocols/gatt/gatt_server.c
@@ -0,0 +1,397 @@
+#include <btcore/gatt_server.h>
+
+#include <string.h>
+
+#define UUID_PRIMARY_SERVICE 0x2800u
+#define UUID_CHARACTERISTIC  0x2803u
+#define UUID_CCCD            0x2902u
+
+static void uuid16(uint8_t out[2], uint16_t value)
+{
+    out[0] = (uint8_t)value;
+    out[1] = (uint8_t)(value >> 8);
+}
+
+static bool uuid_is16(const struct bt_gatt_server_attribute *attr, uint16_t value)
+{
+    return attr->uuid_len == 2 && attr->uuid[0] == (uint8_t)value &&
+           attr->uuid[1] == (uint8_t)(value >> 8);
+}
+
+static struct bt_gatt_server_attribute *find_attr(struct bt_gatt_server *server,
+                                                   uint16_t handle)
+{
+    size_t i;
+    for (i = 0; i < server->attribute_count; ++i)
+        if (server->attributes[i].handle == handle)
+            return &server->attributes[i];
+    return NULL;
+}
+
+static bt_status_t add_attr(struct bt_gatt_server *server, const uint8_t *uuid,
+                            uint8_t uuid_len, uint8_t permissions,
+                            const uint8_t *value, size_t value_len,
+                            bt_gatt_server_read_fn on_read,
+                            bt_gatt_server_write_fn on_write, void *user_data,
+                            uint16_t *out_handle)
+{
+    struct bt_gatt_server_attribute *attr;
+    if (server == NULL || uuid == NULL || (uuid_len != 2 && uuid_len != 16) ||
+        value_len > BT_GATT_SERVER_MAX_STORED_VALUE_LEN || server->started)
+        return BT_ERR_INVALID_ARGUMENT;
+    if (server->attribute_count == BT_GATT_SERVER_MAX_ATTRIBUTES || server->next_handle == 0)
+        return BT_ERR_NO_RESOURCES;
+    attr = &server->attributes[server->attribute_count++];
+    memset(attr, 0, sizeof(*attr));
+    attr->handle = server->next_handle++;
+    attr->uuid_len = uuid_len;
+    memcpy(attr->uuid, uuid, uuid_len);
+    attr->permissions = permissions;
+    if (value_len != 0)
+        memcpy(attr->value, value, value_len);
+    attr->value_len = value_len;
+    attr->on_read = on_read;
+    attr->on_write = on_write;
+    attr->user_data = user_data;
+    if (out_handle != NULL)
+        *out_handle = attr->handle;
+    return BT_OK;
+}
+
+void bt_gatt_server_init(struct bt_gatt_server *server,
+                         struct bt_l2cap_channel_manager *l2cap)
+{
+    memset(server, 0, sizeof(*server));
+    server->l2cap = l2cap;
+    server->next_handle = 1;
+    server->mtu = BT_ATT_DEFAULT_MTU;
+}
+
+bt_status_t bt_gatt_server_add_service(struct bt_gatt_server *server,
+                                        const uint8_t *uuid, uint8_t uuid_len,
+                                        uint16_t *out_service_handle)
+{
+    uint8_t type[2];
+    uuid16(type, UUID_PRIMARY_SERVICE);
+    return add_attr(server, type, 2, BT_GATT_PERM_READ, uuid, uuid_len,
+                    NULL, NULL, NULL, out_service_handle);
+}
+
+bt_status_t bt_gatt_server_add_characteristic(struct bt_gatt_server *server,
+                                               const uint8_t *uuid, uint8_t uuid_len,
+                                               uint8_t properties, uint8_t permissions,
+                                               bt_gatt_server_read_fn on_read,
+                                               bt_gatt_server_write_fn on_write,
+                                               void *user_data,
+                                               uint16_t *out_value_handle)
+{
+    uint8_t decl_type[2];
+    uint8_t declaration[19];
+    uint16_t value_handle;
+    bt_status_t st;
+    if (server == NULL || uuid == NULL || (uuid_len != 2 && uuid_len != 16) ||
+        server->next_handle == 0xffffu)
+        return BT_ERR_INVALID_ARGUMENT;
+    value_handle = (uint16_t)(server->next_handle + 1u);
+    declaration[0] = properties;
+    declaration[1] = (uint8_t)value_handle;
+    declaration[2] = (uint8_t)(value_handle >> 8);
+    memcpy(declaration + 3, uuid, uuid_len);
+    uuid16(decl_type, UUID_CHARACTERISTIC);
+    st = add_attr(server, decl_type, 2, BT_GATT_PERM_READ, declaration,
+                  (size_t)uuid_len + 3u, NULL, NULL, NULL, NULL);
+    if (st != BT_OK)
+        return st;
+    st = add_attr(server, uuid, uuid_len, permissions, NULL, 0,
+                  on_read, on_write, user_data, out_value_handle);
+    if (st != BT_OK) {
+        server->attribute_count--; /* roll back the declaration */
+        server->next_handle--;
+    }
+    return st;
+}
+
+bt_status_t bt_gatt_server_add_cccd(struct bt_gatt_server *server,
+                                    uint16_t characteristic_value_handle,
+                                    uint16_t *out_cccd_handle)
+{
+    uint8_t type[2];
+    uint8_t initial[2] = {0, 0};
+    struct bt_gatt_server_attribute *value = find_attr(server, characteristic_value_handle);
+    if (value == NULL)
+        return BT_ERR_NOT_FOUND;
+    uuid16(type, UUID_CCCD);
+    return add_attr(server, type, 2, BT_GATT_PERM_READ | BT_GATT_PERM_WRITE,
+                    initial, sizeof(initial), NULL, NULL, NULL, out_cccd_handle);
+}
+
+bt_status_t bt_gatt_server_set_value(struct bt_gatt_server *server, uint16_t handle,
+                                      const uint8_t *value, size_t value_len)
+{
+    struct bt_gatt_server_attribute *attr = find_attr(server, handle);
+    if (attr == NULL)
+        return BT_ERR_NOT_FOUND;
+    if ((value == NULL && value_len != 0) || value_len > sizeof(attr->value))
+        return BT_ERR_INVALID_ARGUMENT;
+    if (value_len != 0)
+        memcpy(attr->value, value, value_len);
+    attr->value_len = value_len;
+    return BT_OK;
+}
+
+static bt_status_t send_pdu(struct bt_gatt_server *server, const uint8_t *pdu,
+                            size_t pdu_len, uint64_t now_us)
+{
+    return bt_l2cap_channel_manager_send(server->l2cap, BT_L2CAP_CID_ATT,
+                                          pdu, pdu_len, now_us);
+}
+
+static void send_error(struct bt_gatt_server *server, uint8_t opcode, uint16_t handle,
+                       uint8_t error, uint64_t now_us)
+{
+    uint8_t pdu[5] = {BT_ATT_OPCODE_ERROR_RESPONSE, opcode,
+                      (uint8_t)handle, (uint8_t)(handle >> 8), error};
+    (void)send_pdu(server, pdu, sizeof(pdu), now_us);
+}
+
+static size_t read_value(struct bt_gatt_server_attribute *attr, uint8_t *out, size_t cap)
+{
+    size_t len;
+    if (attr->on_read != NULL)
+    {
+        len = attr->on_read(attr->user_data, out, cap);
+        return len < cap ? len : cap;
+    }
+    len = attr->value_len < cap ? attr->value_len : cap;
+    if (len != 0)
+        memcpy(out, attr->value, len);
+    return len;
+}
+
+static uint16_t service_end_handle(const struct bt_gatt_server *server, size_t index)
+{
+    size_t i;
+    for (i = index + 1; i < server->attribute_count; ++i)
+        if (uuid_is16(&server->attributes[i], UUID_PRIMARY_SERVICE))
+            return (uint16_t)(server->attributes[i].handle - 1u);
+    return server->attribute_count == 0 ? 0 :
+           server->attributes[server->attribute_count - 1].handle;
+}
+
+static void handle_exchange_mtu(struct bt_gatt_server *server, const uint8_t *pdu,
+                                size_t len, uint64_t now_us)
+{
+    uint16_t peer_mtu;
+    uint8_t rsp[3];
+    if (len != 3) {
+        send_error(server, pdu[0], 0, 0x04, now_us);
+        return;
+    }
+    peer_mtu = (uint16_t)(pdu[1] | ((uint16_t)pdu[2] << 8));
+    if (peer_mtu < BT_ATT_DEFAULT_MTU)
+        peer_mtu = BT_ATT_DEFAULT_MTU;
+    server->mtu = peer_mtu < BT_GATT_SERVER_MAX_VALUE_LEN + 1u ?
+                  peer_mtu : BT_GATT_SERVER_MAX_VALUE_LEN + 1u;
+    rsp[0] = BT_ATT_OPCODE_EXCHANGE_MTU_RESPONSE;
+    rsp[1] = (uint8_t)(BT_GATT_SERVER_MAX_VALUE_LEN + 1u);
+    rsp[2] = (uint8_t)((BT_GATT_SERVER_MAX_VALUE_LEN + 1u) >> 8);
+    (void)send_pdu(server, rsp, sizeof(rsp), now_us);
+}
+
+static void handle_find_information(struct bt_gatt_server *server, const uint8_t *pdu,
+                                    size_t len, uint64_t now_us)
+{
+    uint16_t start, end;
+    uint8_t rsp[BT_GATT_SERVER_MAX_VALUE_LEN + 1];
+    size_t pos = 2, i;
+    uint8_t format = 0, uuid_len = 0;
+    if (len != 5) { send_error(server, pdu[0], 0, 0x04, now_us); return; }
+    start = (uint16_t)(pdu[1] | ((uint16_t)pdu[2] << 8));
+    end = (uint16_t)(pdu[3] | ((uint16_t)pdu[4] << 8));
+    for (i = 0; i < server->attribute_count; ++i) {
+        const struct bt_gatt_server_attribute *a = &server->attributes[i];
+        if (a->handle < start || a->handle > end) continue;
+        if (format == 0) { uuid_len = a->uuid_len; format = uuid_len == 2 ? 1 : 2; }
+        if (a->uuid_len != uuid_len || pos + 2u + uuid_len > server->mtu) break;
+        rsp[pos++] = (uint8_t)a->handle; rsp[pos++] = (uint8_t)(a->handle >> 8);
+        memcpy(rsp + pos, a->uuid, uuid_len); pos += uuid_len;
+    }
+    if (format == 0) { send_error(server, pdu[0], start, BT_ATT_ERROR_ATTRIBUTE_NOT_FOUND, now_us); return; }
+    rsp[0] = BT_ATT_OPCODE_FIND_INFORMATION_RESPONSE; rsp[1] = format;
+    (void)send_pdu(server, rsp, pos, now_us);
+}
+
+static void handle_read_by_group(struct bt_gatt_server *server, const uint8_t *pdu,
+                                 size_t len, uint64_t now_us)
+{
+    uint16_t start, end, type;
+    uint8_t rsp[BT_GATT_SERVER_MAX_VALUE_LEN + 1];
+    size_t pos = 2, i;
+    uint8_t entry_len = 0;
+    if (len != 7) { send_error(server, pdu[0], 0, 0x04, now_us); return; }
+    start = (uint16_t)(pdu[1] | ((uint16_t)pdu[2] << 8));
+    end = (uint16_t)(pdu[3] | ((uint16_t)pdu[4] << 8));
+    type = (uint16_t)(pdu[5] | ((uint16_t)pdu[6] << 8));
+    if (type != UUID_PRIMARY_SERVICE) { send_error(server, pdu[0], start, 0x10, now_us); return; }
+    for (i = 0; i < server->attribute_count; ++i) {
+        const struct bt_gatt_server_attribute *a = &server->attributes[i];
+        uint8_t this_len;
+        uint16_t last;
+        if (a->handle < start || a->handle > end || !uuid_is16(a, UUID_PRIMARY_SERVICE)) continue;
+        this_len = (uint8_t)(4u + a->value_len);
+        if (entry_len == 0) entry_len = this_len;
+        if (this_len != entry_len || pos + this_len > server->mtu) break;
+        last = service_end_handle(server, i);
+        rsp[pos++] = (uint8_t)a->handle; rsp[pos++] = (uint8_t)(a->handle >> 8);
+        rsp[pos++] = (uint8_t)last; rsp[pos++] = (uint8_t)(last >> 8);
+        memcpy(rsp + pos, a->value, a->value_len); pos += a->value_len;
+    }
+    if (entry_len == 0) { send_error(server, pdu[0], start, BT_ATT_ERROR_ATTRIBUTE_NOT_FOUND, now_us); return; }
+    rsp[0] = BT_ATT_OPCODE_READ_BY_GROUP_TYPE_RESPONSE; rsp[1] = entry_len;
+    (void)send_pdu(server, rsp, pos, now_us);
+}
+
+static void handle_read_by_type(struct bt_gatt_server *server, const uint8_t *pdu,
+                                size_t len, uint64_t now_us)
+{
+    uint16_t start, end, type;
+    uint8_t rsp[BT_GATT_SERVER_MAX_VALUE_LEN + 1];
+    size_t pos = 2, i;
+    uint8_t entry_len = 0;
+    if (len != 7) { send_error(server, pdu[0], 0, 0x04, now_us); return; }
+    start = (uint16_t)(pdu[1] | ((uint16_t)pdu[2] << 8));
+    end = (uint16_t)(pdu[3] | ((uint16_t)pdu[4] << 8));
+    type = (uint16_t)(pdu[5] | ((uint16_t)pdu[6] << 8));
+    for (i = 0; i < server->attribute_count; ++i) {
+        struct bt_gatt_server_attribute *a = &server->attributes[i];
+        uint8_t value[BT_GATT_SERVER_MAX_VALUE_LEN];
+        size_t value_len;
+        uint8_t this_len;
+        if (a->handle < start || a->handle > end || !uuid_is16(a, type) ||
+            !(a->permissions & BT_GATT_PERM_READ)) continue;
+        value_len = read_value(a, value, sizeof(value));
+        if (value_len > 253u) value_len = 253u;
+        this_len = (uint8_t)(2u + value_len);
+        if (entry_len == 0) entry_len = this_len;
+        if (this_len != entry_len || pos + this_len > server->mtu) break;
+        rsp[pos++] = (uint8_t)a->handle; rsp[pos++] = (uint8_t)(a->handle >> 8);
+        memcpy(rsp + pos, value, value_len); pos += value_len;
+    }
+    if (entry_len == 0) { send_error(server, pdu[0], start, BT_ATT_ERROR_ATTRIBUTE_NOT_FOUND, now_us); return; }
+    rsp[0] = BT_ATT_OPCODE_READ_BY_TYPE_RESPONSE; rsp[1] = entry_len;
+    (void)send_pdu(server, rsp, pos, now_us);
+}
+
+static void handle_read(struct bt_gatt_server *server, const uint8_t *pdu, size_t len,
+                        bool blob, uint64_t now_us)
+{
+    uint16_t handle, offset = 0;
+    struct bt_gatt_server_attribute *a;
+    uint8_t rsp[BT_GATT_SERVER_MAX_VALUE_LEN + 1];
+    size_t value_len, copy_len;
+    if (len != (blob ? 5u : 3u)) { send_error(server, pdu[0], 0, 0x04, now_us); return; }
+    handle = (uint16_t)(pdu[1] | ((uint16_t)pdu[2] << 8));
+    if (blob) offset = (uint16_t)(pdu[3] | ((uint16_t)pdu[4] << 8));
+    a = find_attr(server, handle);
+    if (a == NULL) { send_error(server, pdu[0], handle, 0x01, now_us); return; }
+    if (!(a->permissions & BT_GATT_PERM_READ)) { send_error(server, pdu[0], handle, 0x02, now_us); return; }
+    value_len = read_value(a, rsp + 1, sizeof(rsp) - 1);
+    if (offset > value_len) { send_error(server, pdu[0], handle, BT_ATT_ERROR_INVALID_OFFSET, now_us); return; }
+    copy_len = value_len - offset;
+    if (copy_len > server->mtu - 1u) copy_len = server->mtu - 1u;
+    if (offset != 0 && copy_len != 0) memmove(rsp + 1, rsp + 1 + offset, copy_len);
+    rsp[0] = blob ? BT_ATT_OPCODE_READ_BLOB_RESPONSE : BT_ATT_OPCODE_READ_RESPONSE;
+    (void)send_pdu(server, rsp, copy_len + 1u, now_us);
+}
+
+static void handle_write(struct bt_gatt_server *server, const uint8_t *pdu, size_t len,
+                         bool command, uint64_t now_us)
+{
+    uint16_t handle;
+    struct bt_gatt_server_attribute *a;
+    bool accepted = true;
+    if (len < 3) { if (!command) send_error(server, pdu[0], 0, 0x04, now_us); return; }
+    handle = (uint16_t)(pdu[1] | ((uint16_t)pdu[2] << 8));
+    a = find_attr(server, handle);
+    if (a == NULL || !(a->permissions & BT_GATT_PERM_WRITE)) {
+        if (!command) send_error(server, pdu[0], handle, a == NULL ? 0x01 : 0x03, now_us);
+        return;
+    }
+    if (a->on_write != NULL)
+        accepted = a->on_write(a->user_data, pdu + 3, len - 3);
+    else if (len - 3 <= sizeof(a->value)) {
+        memcpy(a->value, pdu + 3, len - 3); a->value_len = len - 3;
+    } else accepted = false;
+    if (!accepted) { if (!command) send_error(server, pdu[0], handle, 0x0d, now_us); return; }
+    if (!command) { uint8_t rsp = BT_ATT_OPCODE_WRITE_RESPONSE; (void)send_pdu(server, &rsp, 1, now_us); }
+}
+
+static void channel_event(struct bt_l2cap_channel_event_info *info, void *user_data)
+{
+    struct bt_gatt_server *server = (struct bt_gatt_server *)user_data;
+    const uint8_t *p = info->data;
+    size_t len = info->data_len;
+    if (info->event != BT_L2CAP_CHANNEL_EVENT_DATA || len == 0) return;
+    switch (p[0]) {
+    case BT_ATT_OPCODE_EXCHANGE_MTU_REQUEST: handle_exchange_mtu(server, p, len, info->now_us); break;
+    case BT_ATT_OPCODE_FIND_INFORMATION_REQUEST: handle_find_information(server, p, len, info->now_us); break;
+    case BT_ATT_OPCODE_READ_BY_GROUP_TYPE_REQUEST: handle_read_by_group(server, p, len, info->now_us); break;
+    case BT_ATT_OPCODE_READ_BY_TYPE_REQUEST: handle_read_by_type(server, p, len, info->now_us); break;
+    case BT_ATT_OPCODE_READ_REQUEST: handle_read(server, p, len, false, info->now_us); break;
+    case BT_ATT_OPCODE_READ_BLOB_REQUEST: handle_read(server, p, len, true, info->now_us); break;
+    case BT_ATT_OPCODE_WRITE_REQUEST: handle_write(server, p, len, false, info->now_us); break;
+    case BT_ATT_OPCODE_WRITE_COMMAND: handle_write(server, p, len, true, info->now_us); break;
+    case BT_ATT_OPCODE_HANDLE_VALUE_CONFIRMATION: break;
+    default: send_error(server, p[0], 0, 0x06, info->now_us); break;
+    }
+}
+
+bt_status_t bt_gatt_server_start(struct bt_gatt_server *server)
+{
+    bt_status_t st;
+    if (server == NULL || server->l2cap == NULL || server->started || server->attribute_count == 0)
+        return BT_ERR_INVALID_STATE;
+    st = bt_l2cap_channel_manager_open_fixed(server->l2cap, BT_L2CAP_CID_ATT,
+                                              channel_event, server);
+    if (st == BT_OK) server->started = true;
+    return st;
+}
+
+void bt_gatt_server_stop(struct bt_gatt_server *server, uint64_t now_us)
+{
+    if (server != NULL && server->started) {
+        bt_l2cap_channel_manager_close(server->l2cap, BT_L2CAP_CID_ATT, now_us);
+        server->started = false;
+        server->mtu = BT_ATT_DEFAULT_MTU;
+    }
+}
+
+bool bt_gatt_server_is_subscribed(const struct bt_gatt_server *server,
+                                  uint16_t characteristic_value_handle)
+{
+    size_t i;
+    bool found = false;
+    for (i = 0; i < server->attribute_count; ++i) {
+        const struct bt_gatt_server_attribute *a = &server->attributes[i];
+        if (a->handle == characteristic_value_handle) found = true;
+        else if (found && uuid_is16(a, UUID_CCCD))
+            return a->value_len == 2 && (a->value[0] & 0x01u) != 0;
+        else if (found && uuid_is16(a, UUID_CHARACTERISTIC)) break;
+    }
+    return false;
+}
+
+bt_status_t bt_gatt_server_notify(struct bt_gatt_server *server, uint16_t value_handle,
+                                   const uint8_t *value, size_t value_len, uint64_t now_us)
+{
+    uint8_t pdu[BT_GATT_SERVER_MAX_VALUE_LEN + 3];
+    if (server == NULL || !server->started || find_attr(server, value_handle) == NULL)
+        return BT_ERR_INVALID_STATE;
+    if (!bt_gatt_server_is_subscribed(server, value_handle)) return BT_ERR_INVALID_STATE;
+    if (value == NULL || value_len > server->mtu - 3u || value_len > BT_GATT_SERVER_MAX_VALUE_LEN)
+        return BT_ERR_INVALID_ARGUMENT;
+    pdu[0] = BT_ATT_OPCODE_HANDLE_VALUE_NOTIFICATION;
+    pdu[1] = (uint8_t)value_handle; pdu[2] = (uint8_t)(value_handle >> 8);
+    memcpy(pdu + 3, value, value_len);
+    return send_pdu(server, pdu, value_len + 3u, now_us);
+}
