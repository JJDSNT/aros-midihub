diff --git a/rom/bluetooth/stack/include/btcore/gatt_server.h b/rom/bluetooth/stack/include/btcore/gatt_server.h
new file mode 100644
index 0000000000..96178187e0
--- /dev/null
+++ b/rom/bluetooth/stack/include/btcore/gatt_server.h
@@ -0,0 +1,86 @@
+#ifndef BTCORE_GATT_SERVER_H
+#define BTCORE_GATT_SERVER_H
+
+#include <btcore/att.h>
+#include <btcore/l2cap_channel.h>
+#include <btcore/status.h>
+#include <btcore/types.h>
+
+#ifndef BT_GATT_SERVER_MAX_ATTRIBUTES
+#define BT_GATT_SERVER_MAX_ATTRIBUTES 32
+#endif
+
+#ifndef BT_GATT_SERVER_MAX_VALUE_LEN
+#define BT_GATT_SERVER_MAX_VALUE_LEN 512
+#endif
+
+#ifndef BT_GATT_SERVER_MAX_STORED_VALUE_LEN
+#define BT_GATT_SERVER_MAX_STORED_VALUE_LEN 32
+#endif
+
+#define BT_GATT_PERM_READ  0x01u
+#define BT_GATT_PERM_WRITE 0x02u
+
+#define BT_GATT_CHAR_PROP_READ                   0x02u
+#define BT_GATT_CHAR_PROP_WRITE_WITHOUT_RESPONSE 0x04u
+#define BT_GATT_CHAR_PROP_WRITE                  0x08u
+#define BT_GATT_CHAR_PROP_NOTIFY                 0x10u
+#define BT_GATT_CHAR_PROP_INDICATE               0x20u
+
+typedef size_t (*bt_gatt_server_read_fn)(void *user_data, uint8_t *value, size_t capacity);
+typedef bool (*bt_gatt_server_write_fn)(void *user_data, const uint8_t *value, size_t value_len);
+
+struct bt_gatt_server_attribute
+{
+    uint16_t handle;
+    uint8_t uuid_len;
+    uint8_t uuid[16]; /* ATT little-endian byte order */
+    uint8_t permissions;
+    uint8_t value[BT_GATT_SERVER_MAX_STORED_VALUE_LEN];
+    size_t value_len;
+    bt_gatt_server_read_fn on_read;
+    bt_gatt_server_write_fn on_write;
+    void *user_data;
+};
+
+struct bt_gatt_server
+{
+    struct bt_l2cap_channel_manager *l2cap;
+    struct bt_gatt_server_attribute attributes[BT_GATT_SERVER_MAX_ATTRIBUTES];
+    size_t attribute_count;
+    uint16_t next_handle;
+    uint16_t mtu;
+    bool started;
+};
+
+void bt_gatt_server_init(struct bt_gatt_server *server,
+                         struct bt_l2cap_channel_manager *l2cap);
+
+/* Registration helpers allocate consecutive handles and copy UUID/value bytes,
+ * so callers may release their input buffers after the call. UUIDs use ATT
+ * wire order. Add the complete database before start(). */
+bt_status_t bt_gatt_server_add_service(struct bt_gatt_server *server,
+                                        const uint8_t *uuid, uint8_t uuid_len,
+                                        uint16_t *out_service_handle);
+bt_status_t bt_gatt_server_add_characteristic(struct bt_gatt_server *server,
+                                               const uint8_t *uuid, uint8_t uuid_len,
+                                               uint8_t properties, uint8_t permissions,
+                                               bt_gatt_server_read_fn on_read,
+                                               bt_gatt_server_write_fn on_write,
+                                               void *user_data,
+                                               uint16_t *out_value_handle);
+bt_status_t bt_gatt_server_add_cccd(struct bt_gatt_server *server,
+                                    uint16_t characteristic_value_handle,
+                                    uint16_t *out_cccd_handle);
+
+bt_status_t bt_gatt_server_set_value(struct bt_gatt_server *server, uint16_t handle,
+                                      const uint8_t *value, size_t value_len);
+bt_status_t bt_gatt_server_start(struct bt_gatt_server *server);
+void bt_gatt_server_stop(struct bt_gatt_server *server, uint64_t now_us);
+
+bool bt_gatt_server_is_subscribed(const struct bt_gatt_server *server,
+                                  uint16_t characteristic_value_handle);
+bt_status_t bt_gatt_server_notify(struct bt_gatt_server *server, uint16_t value_handle,
+                                   const uint8_t *value, size_t value_len, uint64_t now_us);
+
+#endif /* BTCORE_GATT_SERVER_H */
