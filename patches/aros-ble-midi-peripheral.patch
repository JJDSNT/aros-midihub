+bt_status_t bt_hci_encode_le_set_advertising_parameters(
+    struct bt_buf_writer *w, uint16_t interval_min, uint16_t interval_max,
+    uint8_t advertising_type, uint8_t own_address_type, uint8_t peer_address_type,
+    const uint8_t *peer_address, uint8_t channel_map, uint8_t filter_policy)
+{
+    uint8_t params[15] = {0};
+    struct bt_buf_writer pw;
+    if (interval_min < 0x0020u || interval_max < interval_min || interval_max > 0x4000u ||
+        advertising_type > 4u || own_address_type > 3u || peer_address_type > 1u ||
+        channel_map == 0 || (channel_map & ~0x07u) != 0 || filter_policy > 3u)
+        return BT_ERR_INVALID_ARGUMENT;
+    bt_buf_writer_init(&pw, params, sizeof(params));
+    bt_buf_writer_write_le16(&pw, interval_min);
+    bt_buf_writer_write_le16(&pw, interval_max);
+    bt_buf_writer_write_u8(&pw, advertising_type);
+    bt_buf_writer_write_u8(&pw, own_address_type);
+    bt_buf_writer_write_u8(&pw, peer_address_type);
+    if (peer_address != NULL)
+        bt_buf_writer_write_bytes(&pw, peer_address, 6);
+    else
+        bt_buf_writer_write_bytes(&pw, params + 7, 6);
+    bt_buf_writer_write_u8(&pw, channel_map);
+    bt_buf_writer_write_u8(&pw, filter_policy);
+    return bt_hci_encode_command(w, BT_HCI_OPCODE_LE_SET_ADVERTISING_PARAMETERS,
+                                  params, sizeof(params));
+}
+
+static bt_status_t encode_advertising_payload(struct bt_buf_writer *w, uint16_t opcode,
+                                               const uint8_t *data, size_t data_len)
+{
+    uint8_t params[32] = {0};
+    if (data_len > 31u || (data == NULL && data_len != 0))
+        return BT_ERR_INVALID_ARGUMENT;
+    params[0] = (uint8_t)data_len;
+    if (data_len != 0)
+        memcpy(params + 1, data, data_len);
+    return bt_hci_encode_command(w, opcode, params, sizeof(params));
+}
+
+bt_status_t bt_hci_encode_le_set_advertising_data(struct bt_buf_writer *w,
+                                                   const uint8_t *data, size_t data_len)
+{
+    return encode_advertising_payload(w, BT_HCI_OPCODE_LE_SET_ADVERTISING_DATA,
+                                      data, data_len);
+}
+
+bt_status_t bt_hci_encode_le_set_scan_response_data(struct bt_buf_writer *w,
+                                                     const uint8_t *data, size_t data_len)
+{
+    return encode_advertising_payload(w, BT_HCI_OPCODE_LE_SET_SCAN_RESPONSE_DATA,
+                                      data, data_len);
+}
+
+bt_status_t bt_hci_encode_le_set_advertising_enable(struct bt_buf_writer *w, bool enable)
+{
+    uint8_t value = enable ? 1u : 0u;
+    return bt_hci_encode_command(w, BT_HCI_OPCODE_LE_SET_ADVERTISING_ENABLE, &value, 1);
+}
