diff --git a/workbench/libs/camd/endclusterwatch.c b/workbench/libs/camd/endclusterwatch.c
new file mode 100644
index 0000000000..5f7f338703
--- /dev/null
+++ b/workbench/libs/camd/endclusterwatch.c
@@ -0,0 +1,58 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH1(void, EndClusterWatch,
+
+/*  SYNOPSIS */
+	AROS_LHA(APTR, handle, A0),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 44, Camd)
+
+/*  FUNCTION
+		Stops watching clusters and frees the handle with the events it
+		still holds.
+
+    INPUTS
+		handle - from StartClusterWatchA(), or NULL.
+
+    RESULT
+
+    NOTES
+		New in V42. The task is not signalled for this handle once this
+		returns; a signal sent before may still be pending.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		StartClusterWatchA()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	struct ClusterWatch *watch=(struct ClusterWatch *)handle;
+
+	if(watch==NULL) return;
+
+	ObtainSemaphore(&CB(CamdBase)->NotifySemaphore);
+	Remove((struct Node *)&watch->node);
+	ReleaseSemaphore(&CB(CamdBase)->NotifySemaphore);
+
+	FreeMem(watch,sizeof(struct ClusterWatch));
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/camd/getclusterattrsa.c b/workbench/libs/camd/getclusterattrsa.c
new file mode 100644
index 0000000000..5e308ce74d
--- /dev/null
+++ b/workbench/libs/camd/getclusterattrsa.c
@@ -0,0 +1,111 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+#include <proto/utility.h>
+
+#include "camd_intern.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH2(ULONG, GetClusterAttrsA,
+
+/*  SYNOPSIS */
+	AROS_LHA(struct MidiCluster *, cluster, A0),
+	AROS_LHA(struct TagItem *, tags, A1),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 41, Camd)
+
+/*  FUNCTION
+		Reads attributes of a cluster. Each tag's ti_Data points to an
+		IPTR that receives the value.
+
+    INPUTS
+		cluster - from FindCluster() or NextCluster(), with CAMD locked
+		          by LockCAMD() so that it cannot go away.
+		tags - MCLA_Name (STRPTR)
+		       MCLA_Comment (STRPTR) - the cluster's comment, NULL if none
+		       MCLA_Participants (ULONG) - links in the cluster; a driver
+		           port is not a link
+		       MCLA_PublicParticipants (ULONG) - those not MLINK_Private
+		       MCLA_HasDriver (BOOL) - a DEVS:Midi driver port is in it
+		       MCLA_Overflows (ULONG) - messages dropped because a
+		           receiver's queue was full
+		       MCLA_SysExDropped (ULONG) - SysEx messages dropped because
+		           a receiver's SysEx buffer was full
+		       MCLA_RecvErrors (ULONG) - errors and overruns of the
+		           driver port receiving into the cluster
+
+    RESULT
+		The number of tags understood.
+
+    NOTES
+		New in V42. The counters are kept without locking and start at
+		0 when the cluster is created; they are meant for diagnosis.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		GetMidiLinkAttrsA(), NextCluster()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	struct MyMidiCluster *mycluster=(struct MyMidiCluster *)cluster;
+	struct TagItem *tag;
+	struct TagItem *tstate=tags;
+	IPTR *where;
+	ULONG ret=0;
+
+	ObtainSemaphoreShared(CB(CamdBase)->CLSemaphore);
+
+	while((tag=NextTagItem(&tstate))){
+		ret++;
+		where=(IPTR *)tag->ti_Data;
+		switch(tag->ti_Tag){
+			case MCLA_Name:
+				*where=(IPTR)cluster->mcl_Node.ln_Name;
+				break;
+			case MCLA_Comment:
+				*where=(IPTR)NULL;
+				break;
+			case MCLA_Participants:
+				*where=(IPTR)(UWORD)cluster->mcl_Participants;
+				break;
+			case MCLA_PublicParticipants:
+				*where=(IPTR)(UWORD)cluster->mcl_PublicParticipants;
+				break;
+			case MCLA_HasDriver:
+				*where=(IPTR)(FindSenderDriverInCluster(cluster)!=NULL ||
+				              FindReceiverDriverInCluster(cluster)!=NULL);
+				break;
+			case MCLA_Overflows:
+				*where=(IPTR)mycluster->overflows;
+				break;
+			case MCLA_SysExDropped:
+				*where=(IPTR)mycluster->sysexdropped;
+				break;
+			case MCLA_RecvErrors:
+				*where=(IPTR)mycluster->recverrors;
+				break;
+			default:
+				ret--;
+				break;
+		}
+	}
+
+	ReleaseSemaphore(CB(CamdBase)->CLSemaphore);
+
+	return ret;
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/camd/getclusterwatchevent.c b/workbench/libs/camd/getclusterwatchevent.c
new file mode 100644
index 0000000000..1e36a29aae
--- /dev/null
+++ b/workbench/libs/camd/getclusterwatchevent.c
@@ -0,0 +1,76 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH2(BOOL, GetClusterWatchEvent,
+
+/*  SYNOPSIS */
+	AROS_LHA(APTR, handle, A0),
+	AROS_LHA(struct ClusterWatchEvent *, event, A1),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 45, Camd)
+
+/*  FUNCTION
+		Takes the oldest event from a cluster watch.
+
+    INPUTS
+		handle - from StartClusterWatchA().
+		event - filled in with the event.
+
+    RESULT
+		TRUE if there was an event, FALSE if none is left.
+
+    NOTES
+		New in V42. Read events until it returns FALSE after each
+		signal. When events were lost the first one returned is
+		CWE_Lost, with an empty name, and the events still kept follow.
+
+    EXAMPLE
+		while(GetClusterWatchEvent(watch,&event)){
+			if(event.cwe_Type==CWE_Lost) rescan_all();
+			else update(event.cwe_Type,event.cwe_Name);
+		}
+
+    BUGS
+
+    SEE ALSO
+		StartClusterWatchA()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	struct ClusterWatch *watch=(struct ClusterWatch *)handle;
+	BOOL ret=FALSE;
+
+	if(watch==NULL || event==NULL) return FALSE;
+
+	ObtainSemaphore(&CB(CamdBase)->NotifySemaphore);
+	if(watch->lost){
+		watch->lost=FALSE;
+		event->cwe_Type=CWE_Lost;
+		event->cwe_Name[0]=0;
+		ret=TRUE;
+	}else if(watch->count>0){
+		*event=watch->events[watch->first];
+		watch->first=(watch->first+1)%CLUSTERWATCH_QUEUE;
+		watch->count--;
+		ret=TRUE;
+	}
+	ReleaseSemaphore(&CB(CamdBase)->NotifySemaphore);
+
+	return ret;
+
+    AROS_LIBFUNC_EXIT
+}
