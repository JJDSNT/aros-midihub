 LONG StartEndpointWatch(struct CAMDHandleV1 *watch, ULONG signal, struct CAMDGenerationV1 *generation) (A0, D0, A1)
 LONG GetEndpointWatchEvent(struct CAMDHandleV1 *watch, struct CAMDEndpointWatchEventV1 *event) (A0, A1)
 void EndEndpointWatch(struct CAMDHandleV1 *watch) (A0)
+LONG PublishEndpoint(struct CAMDPublishRequestV1 *request, struct CAMDHandleV1 *endpoint, struct CAMDEndpointIDV1 *id) (A0, A1, A2)
+void WithdrawEndpoint(struct CAMDHandleV1 *endpoint) (A0)
