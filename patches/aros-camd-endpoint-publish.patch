diff --git a/workbench/libs/camd/publishendpoint.c b/workbench/libs/camd/publishendpoint.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/publishendpoint.c
@@ -0,0 +1,69 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+#include "provider_contract.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH3(LONG, PublishEndpoint,
+
+/*  SYNOPSIS */
+	AROS_LHA(struct CAMDPublishRequestV1 *, request, A0),
+	AROS_LHA(struct CAMDHandleV1 *, endpoint, A1),
+	AROS_LHA(struct CAMDEndpointIDV1 *, id, A2),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 58, Camd)
+
+/*  FUNCTION
+		Publishes an endpoint of the calling program: other programs
+		see it in their snapshots and open sessions with it, as with a
+		driver's port. The publisher reads what they send with
+		GetPublishedMidi() and sends to them with PutPublishedMidi()
+		and PutPublishedSysEx().
+
+    INPUTS
+		request - the endpoint's name, directions and signal.
+		endpoint - filled in with the publisher's handle.
+		id - NULL, or filled in with the endpoint's stable ID.
+
+    RESULT
+		CAMD_REGISTRY_OK, CAMD_REGISTRY_DUPLICATE while an endpoint of
+		that name is published, or another CAMD_REGISTRY_ value.
+
+    NOTES
+		New in V43 and provisional: the endpoint functions can still
+		change. The same name gets the same ID
+		again, also after a reboot. Withdraw every endpoint before
+		closing camd.library.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		WithdrawEndpoint(), SetPublishedEndpointState(), GetPublishedMidi()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	if(endpoint!=NULL){
+		endpoint->slot=0;
+		endpoint->generation=0;
+	}
+	if(request==NULL || endpoint==NULL) return CAMD_REGISTRY_INVALID;
+
+	return PublishAppEndpoint(request,endpoint,id,CamdBase);
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/camd/putpublishedmidi.c b/workbench/libs/camd/putpublishedmidi.c
new file mode 100644
--- /dev/null
+++ b/workbench/libs/camd/putpublishedmidi.c
@@ -0,0 +1,61 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <proto/exec.h>
+
+#include "camd_intern.h"
+#include "endpoint_registry.h"
+#include "provider_contract.h"
+
+/*****************************************************************************
+
+    NAME */
+
+	AROS_LH3(LONG, PutPublishedMidi,
+
+/*  SYNOPSIS */
+	AROS_LHA(struct CAMDHandleV1 *, endpoint, A0),
+	AROS_LHA(struct CAMDMIDI1EventV1 *, events, A1),
+	AROS_LHA(ULONG, count, D0),
+
+/*  LOCATION */
+	struct CamdBase *, CamdBase, 61, Camd)
+
+/*  FUNCTION
+		Gives complete MIDI 1.0 messages to every client that receives
+		from a published endpoint.
+
+    INPUTS
+		endpoint - from PublishEndpoint().
+		events - count records, each with Size and Version set.
+		count - at least 1.
+
+    RESULT
+		CAMD_REGISTRY_OK, CAMD_REGISTRY_STALE for a withdrawn endpoint,
+		or another CAMD_REGISTRY_ value.
+
+    NOTES
+		New in V43 and provisional: the endpoint functions can still
+		change. Does not wait. A client whose queue
+		is full loses the messages and is told so.
+
+    EXAMPLE
+
+    BUGS
+
+    SEE ALSO
+		PutPublishedSysEx(), GetPublishedMidi()
+
+    INTERNALS
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+	if(endpoint==NULL) return CAMD_REGISTRY_INVALID;
+
+	return PutAppEndpointMidi(endpoint,events,count,CamdBase);
+
+    AROS_LIBFUNC_EXIT
+}
